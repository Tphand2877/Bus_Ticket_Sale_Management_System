    <common:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    <common:TicketStatusToBrushConverter x:Key="TicketStatusToBrush"/>
    <common:NotificationKindToBrushConverter x:Key="NotificationKindToBrush"/>
    <common:NotificationKindToGlyphConverter x:Key="NotificationKindToGlyph"/>

    <!-- ====================================================
         KEYBOARD FOCUS RING
         A focus-visible affordance applied by every button style below: without it a
         keyboard-only user has no idea which control Tab has landed on.
         ==================================================== -->
    <Color x:Key="FocusRingColor">#2563EB</Color>
    <SolidColorBrush x:Key="FocusRingBrush" Color="{StaticResource FocusRingColor}" po:Freeze="True"/>

    <!-- Implicit Button defaults: apply to every Button regardless of the explicit Style it picks,
         because BasedOn is not used anywhere in this file. Without ShowOnDisabled, a tooltip that
         explains WHY a button is disabled is silently suppressed by WPF. -->
    <Style TargetType="Button">
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        <Setter Property="ToolTipService.InitialShowDelay" Value="350"/>
    </Style>

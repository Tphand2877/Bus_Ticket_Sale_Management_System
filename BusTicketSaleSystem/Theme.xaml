    <!-- ====================================================
         CONVERTERS
         ==================================================== -->
    <common:TicketStatusToDisplayConverter x:Key="TicketStatusToDisplay"/>
    <common:PaymentStatusToDisplayConverter x:Key="PaymentStatusToDisplay"/>
    <common:TabActiveBrushConverter x:Key="TabActiveBrushConverter"/>
    <common:TabActiveTextBrushConverter x:Key="TabActiveTextBrushConverter"/>
    <common:BooleanToVisibilityInvertedConverter x:Key="BooleanToVisibilityInvertedConverter"/>
    <common:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>

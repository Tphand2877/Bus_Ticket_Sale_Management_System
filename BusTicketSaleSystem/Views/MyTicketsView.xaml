<UserControl x:Class="BusTicketSaleSystem.Views.MyTicketsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BusTicketSaleSystem.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MyTicketsViewModel}"
             FontFamily="{StaticResource AppFont}">

    <StackPanel>
        <!-- Page Header & Action -->
        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="My Tickets 🎫"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="View active tickets, boarding points, assigned seats, and schedules."
                           FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="+ Book Another Ticket"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding BookNewTicketCommand}"
                    VerticalAlignment="Center"
                    Height="40"
                    Padding="16,0"/>
        </Grid>

        <!-- Tickets List -->
        <ItemsControl ItemsSource="{Binding Tickets}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16" Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- Ticket Code & Status -->
                                <ColumnDefinition Width="180"/>
                                <!-- Route & Schedule -->
                                <ColumnDefinition Width="2*"/>
                                <!-- Seat & Details -->
                                <ColumnDefinition Width="1.5*"/>
                                <!-- Price & Action -->
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>

                            <!-- Column 0: Code & Status -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="TICKET REF" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding TicketCode}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,8"/>
                                
                                <Border Background="#ECFDF5"
                                        BorderBrush="#A7F3D0"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="8,3"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Foreground="#065F46"/>
                                </Border>
                            </StackPanel>

                            <!-- Column 1: Route & Schedule -->
                            <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="🚍 " FontSize="14"/>
                                    <TextBlock Text="{Binding Route}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                    <TextBlock Text="📅 " FontSize="12"/>
                                    <TextBlock Text="{Binding Date}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="  •  🕒 " FontSize="12"/>
                                    <TextBlock Text="{Binding Time}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding BoardingPoint}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>

                            <!-- Column 2: Bus & Seat -->
                            <StackPanel Grid.Column="2" Margin="0,0,16,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding BusOperator}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding BusType}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Seat: " FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding SeatNumber}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Column 3: Price & Action -->
                            <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Price}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                <Button Content="View Pass"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Padding="14,6"
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </StackPanel>
</UserControl>

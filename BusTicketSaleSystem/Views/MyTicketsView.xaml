<UserControl x:Class="BusTicketSaleSystem.Views.MyTicketsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:BusTicketSaleSystem.Common"
             FontFamily="{StaticResource AppFont}">


    <StackPanel>
        <!-- Header -->
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Vé xe của tôi" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Quản lý và xem lại thông tin các vé xe đang hoạt động của bạn."
                           FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Làm mới"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,10,0"
                        Padding="14,8"/>
                <Button Content="+ Đặt vé mới"
                        Command="{Binding BookNewTicketCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Padding="16,8"/>
            </StackPanel>
        </Grid>

        <ProgressBar Height="4"
                     Margin="0,0,0,12"
                     IsIndeterminate="True"
                     Style="{StaticResource ModernProgressBarStyle}"
                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- Status Message Banner -->
        <Border Background="{StaticResource PrimaryLightBrush}"
                BorderBrush="{StaticResource PrimaryTintBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,0,0,16"
                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="{StaticResource PrimaryBrush}" FontWeight="Medium" TextWrapping="Wrap"/>
        </Border>

        <!-- Error Banner -->
        <Border Background="{StaticResource DangerLightBrush}"
                BorderBrush="{StaticResource DangerBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,0,0,16"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" FontSize="13" Foreground="{StaticResource DangerBrush}" FontWeight="Medium" TextWrapping="Wrap"/>
        </Border>

        <!-- Confirmation gate for the two irreversible actions (cancel / refund).
             Inline rather than a MessageBox, matching the admin delete-confirmation pattern. -->
        <Border Background="{StaticResource WarningLightBrush}"
                BorderBrush="{StaticResource WarningBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,14"
                Margin="0,0,0,16"
                Visibility="{Binding IsConfirmingAction, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding ConfirmationPrompt}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#92400E"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                    <Button Content="{Binding ConfirmActionLabel}"
                            Command="{Binding ConfirmPendingActionCommand}"
                            Style="{StaticResource DangerButtonStyle}"
                            Height="34" Padding="14,0" Margin="0,0,8,0"/>
                    <Button Content="{DynamicResource ConfirmKeepTicket}"
                            Command="{Binding DismissPendingActionCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="34" Padding="12,0"
                            IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Active Tickets List -->
        <ItemsControl ItemsSource="{Binding Tickets}"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}" Padding="20,18" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2.5*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Ticket Code & Status -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TicketCode}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Border Background="{StaticResource PrimaryLightBrush}"
                                            CornerRadius="6"
                                            Padding="8,3"
                                            Margin="0,0,6,0">
                                        <TextBlock Text="{Binding Status, Converter={StaticResource TicketStatusToDisplay}}"
                                                   FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                    </Border>
                                    <Border Background="{StaticResource SurfaceMutedBrush}"
                                            CornerRadius="6"
                                            Padding="8,3">
                                        <TextBlock Text="{Binding PaymentStatus, Converter={StaticResource PaymentStatusToDisplay}}"
                                                   FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- Route & Departure Time -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                <TextBlock Text="{Binding Route}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Path Data="{StaticResource IconCalendar}" Fill="{StaticResource TextMutedBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding Date}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text=" • " FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    <Path Data="{StaticResource IconClock}" Fill="{StaticResource TextMutedBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding Time}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding BusType}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Seats & Price -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0">
                                <TextBlock Text="{Binding SeatNumbers, StringFormat=Ghế: {0}}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding Price}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Action Buttons -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Paid tickets can open the e-ticket; pending payments keep the card visible but disable this action. -->
                            <Button Content="Xem vé điện tử"
                                    Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="14,8"
                                    Margin="0,0,8,0"
                                    Visibility="{Binding CanViewETicket, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Button Content="Chờ thanh toán"
                                    IsEnabled="False"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="14,8"
                                    Margin="0,0,8,0"
                                    Visibility="{Binding IsPendingPayment, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <!-- Cancel releases an unpaid reservation -->
                                <Button Content="Hủy giữ chỗ"
                                        Command="{Binding DataContext.CancelTicketCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource DangerOutlineButtonStyle}"
                                        Padding="12,8"
                                        Margin="0,0,8,0"
                                        ToolTip="Khả dụng khi vé đang được giữ chỗ và chưa thanh toán."
                                        Visibility="{Binding CanCancel, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <!-- Refund applies to an already settled ticket -->
                                <Button Content="Yêu cầu hoàn vé"
                                        Command="{Binding DataContext.RequestRefundCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource DangerOutlineButtonStyle}"
                                        Padding="12,8"
                                        ToolTip="Khả dụng cho vé đã thanh toán trước giờ khởi hành. Nhân viên sẽ hỗ trợ hoàn tiền."
                                        Visibility="{Binding CanRequestRefund, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Empty State When No Active Tickets -->
        <Border Style="{StaticResource CardStyle}"
                Padding="40,36"
                Margin="0,10,0,0"
                Visibility="{Binding HasNoTickets, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center">
                <Border Width="60" Height="60" CornerRadius="30" Background="{StaticResource PrimaryLightBrush}" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Path Data="{StaticResource IconTicket}" Fill="{StaticResource PrimaryBrush}" Width="26" Height="26" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <TextBlock Text="Chưa có vé nào đang hoạt động"
                           FontSize="18"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Bạn chưa có hành trình nào sắp tới. Đặt vé ngay để bắt đầu chuyến đi."
                           FontSize="13"
                           Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,20"/>
                <Button Content="Đặt vé ngay"
                        Command="{Binding BookNewTicketCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Center"
                        Padding="22,10"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

<UserControl x:Class="BusTicketSaleSystem.Views.SeatSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:BusTicketSaleSystem.Common"
             FontFamily="{StaticResource AppFont}">

    <UserControl.Resources>
        <common:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <common:BooleanToVisibilityInvertedConverter x:Key="BooleanToVisibilityInvertedConverter"/>
        <common:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </UserControl.Resources>

    <StackPanel>
        <!-- Top Journey Navigation & Steps Indicator -->
        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Route Title & Trip Meta -->
            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Trip.Origin}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <Path Data="{StaticResource IconArrowRight}" Fill="{StaticResource PrimaryBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="10,0"/>
                    <TextBlock Text="{Binding Trip.Destination}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>

                    <Border Background="{StaticResource PrimaryLightBrush}"
                            BorderBrush="{StaticResource PrimaryTintBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,4"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding Trip.BusType}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Path Data="{StaticResource IconCalendar}" Fill="{StaticResource TextMutedBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding Trip.Schedule}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text=" • " FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding Trip.PriceDisplay, StringFormat='Giá vé: {0}'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- Back Button -->
            <Button Grid.Column="1"
                    Content="← Chọn chuyến khác"
                    Command="{Binding BackToBookingCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    VerticalAlignment="Center"
                    Padding="16,8"/>
        </Grid>

        <!-- Status Message Banner -->
        <Border Background="{StaticResource PrimaryLightBrush}"
                BorderBrush="{StaticResource PrimaryTintBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,0,0,20"
                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="{StaticResource PrimaryBrush}" FontWeight="Medium"/>
        </Border>

        <!-- Main Layout: 2 Columns (Bus Cabin Floorplan + Passenger & Summary) -->
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Left: Bus Seating Cabin -->
                <ColumnDefinition Width="1.4*"/>
                <!-- Gap -->
                <ColumnDefinition Width="24"/>
                <!-- Right: Passenger Form & Price Summary -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ====================================================
                 LEFT: BUS CABIN FLOORPLAN
                 ==================================================== -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="24">
                <StackPanel>
                    <!-- Cabin Title & Live Counters -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Sơ đồ ghế trên xe" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Nhấn vào ghế bạn muốn chọn (màu xanh là ghế đang chọn)" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Seat Counters Pill -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{StaticResource SuccessLightBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                                <TextBlock Text="{Binding AvailableSeatsCount, StringFormat='{}Trống: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                            </Border>
                            <Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="6" Padding="8,4">
                                <TextBlock Text="{Binding BookedSeatsCount, StringFormat='{}Đã đặt: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Seating Legend Strip -->
                    <Border Background="{StaticResource BackgroundBrush}" CornerRadius="10" Padding="14,10" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Available -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Width="20" Height="20" CornerRadius="5" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1.5" Margin="0,0,8,0"/>
                                <TextBlock Text="Ghế trống" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Selected -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Width="20" Height="20" CornerRadius="5" Background="{StaticResource PrimaryBrush}" Margin="0,0,8,0">
                                    <Path Data="{StaticResource IconCheck}" Fill="White" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Đang chọn" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Booked -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Width="20" Height="20" CornerRadius="5" Background="#CBD5E1" Margin="0,0,8,0"/>
                                <TextBlock Text="Đã được đặt" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Bus Cabin Outline Simulation -->
                    <Border Background="#F8FAFC"
                            BorderBrush="#CBD5E1"
                            BorderThickness="2"
                            CornerRadius="24,24,14,14"
                            Padding="18,20"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <!-- Front of Bus Header (Windshield & Driver) -->
                            <Grid Margin="0,0,0,20" Height="40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Entrance Door Indicator -->
                                <Border Grid.Column="0" Background="#E2E8F0" CornerRadius="6" HorizontalAlignment="Left" Padding="10,4" VerticalAlignment="Center">
                                    <TextBlock Text="Cửa lên/xuống" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>

                                <!-- Front Windshield Curve -->
                                <Border Grid.Column="1" Background="#E0E7FF" CornerRadius="10" Padding="16,5" VerticalAlignment="Center">
                                    <TextBlock Text="ĐẦU XE (Front)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                </Border>

                                <!-- Driver Area -->
                                <Border Grid.Column="2" Background="#FEF3C7" CornerRadius="6" HorizontalAlignment="Right" Padding="10,4" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Vô lăng tài xế" FontSize="11" FontWeight="SemiBold" Foreground="#92400E"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Separator Background="#E2E8F0" Margin="0,0,0,18"/>

                            <!-- Interactive Seats Grid -->
                            <ListBox ItemsSource="{Binding Seats}"
                                     SelectedItem="{Binding SelectedSeat}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel HorizontalAlignment="Center" ItemWidth="80" ItemHeight="70"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>

                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="4"/>
                                        <Setter Property="Margin" Value="4"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="IsEnabled" Value="{Binding IsBooked, Converter={StaticResource InverseBooleanConverter}}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="seatBorder"
                                                            Background="White"
                                                            BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1.5"
                                                            CornerRadius="10"
                                                            Cursor="Hand"
                                                            Padding="6,8">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <!-- Seat Icon -->
                                                            <Path x:Name="seatIcon"
                                                                  Grid.Row="0"
                                                                  Data="{StaticResource IconSeat}"
                                                                  Fill="{StaticResource PrimaryBrush}"
                                                                  Width="20" Height="20"
                                                                  Stretch="Uniform"
                                                                  HorizontalAlignment="Center"
                                                                  Margin="0,0,0,4"/>

                                                            <!-- Seat Number / Label -->
                                                            <TextBlock x:Name="seatNum"
                                                                       Grid.Row="1"
                                                                       Text="{Binding SeatNumber, StringFormat='Ghế {0}'}"
                                                                       FontSize="11"
                                                                       FontWeight="Bold"
                                                                       HorizontalAlignment="Center"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        </Grid>
                                                    </Border>

                                                    <ControlTemplate.Triggers>
                                                        <!-- Mouse Over (When Available) -->
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="seatBorder" Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
                                                            <Setter TargetName="seatBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                        </Trigger>

                                                        <!-- Selected Seat -->
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="seatBorder" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                                            <Setter TargetName="seatBorder" Property="BorderBrush" Value="{StaticResource PrimaryHoverBrush}"/>
                                                            <Setter TargetName="seatIcon" Property="Fill" Value="White"/>
                                                            <Setter TargetName="seatNum" Property="Foreground" Value="White"/>
                                                        </Trigger>

                                                        <!-- Booked Seat -->
                                                        <DataTrigger Binding="{Binding IsBooked}" Value="True">
                                                            <Setter TargetName="seatBorder" Property="Background" Value="#F1F5F9"/>
                                                            <Setter TargetName="seatBorder" Property="BorderBrush" Value="#CBD5E1"/>
                                                            <Setter TargetName="seatBorder" Property="Cursor" Value="No"/>
                                                            <Setter TargetName="seatIcon" Property="Fill" Value="#94A3B8"/>
                                                            <Setter TargetName="seatNum" Property="Foreground" Value="#94A3B8"/>
                                                            <Setter TargetName="seatNum" Property="Text" Value="{Binding SeatNumber, StringFormat='{}{0} (Đã đặt)'}"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>

                            <Separator Background="#E2E8F0" Margin="0,18,0,12"/>

                            <TextBlock Text="ĐUÔI XE (Rear)" HorizontalAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ====================================================
                 RIGHT: PASSENGER FORM & BOOKING SUMMARY
                 ==================================================== -->
            <StackPanel Grid.Column="2">
                <!-- Passenger Info Card -->
                <Border Style="{StaticResource CardStyle}" Padding="22" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="Thông tin hành khách" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Thông tin dùng để in vé và liên hệ đón xe." FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16"/>

                        <!-- Passenger Name -->
                        <TextBlock Text="Họ và tên hành khách *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding PassengerName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Height="42"
                                 Margin="0,0,0,14"/>

                        <!-- Passenger Phone -->
                        <TextBlock Text="Số điện thoại liên hệ *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding PassengerPhone, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Height="42"/>
                    </StackPanel>
                </Border>

                <!-- Pricing & Selected Seat Summary Card -->
                <Border Style="{StaticResource CardStyle}" Padding="22" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="Tóm tắt giá vé" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Ghế đã chọn:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="6" Padding="8,2" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding SelectedSeatNumber, StringFormat='Ghế {0}'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                            </Border>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Giá vé niêm yết:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding Trip.PriceDisplay}" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <TextBlock Text="Phí dịch vụ &amp; bảo hiểm:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="0 VND" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                        </Grid>

                        <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,14"/>

                        <!-- Total Price -->
                        <Grid Margin="0,0,0,18">
                            <TextBlock Text="Tổng thanh toán:" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalPriceDisplay}" HorizontalAlignment="Right" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                        </Grid>

                        <!-- Proceed Button -->
                        <Button Content="Tiếp tục xác nhận vé →"
                                Command="{Binding GoToConfirmationCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                Height="44"
                                FontSize="14"
                                FontWeight="Bold"/>

                        <Button Content="Quay lại danh sách chuyến"
                                Command="{Binding BackToBookingCommand}"
                                Style="{StaticResource GhostButtonStyle}"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>

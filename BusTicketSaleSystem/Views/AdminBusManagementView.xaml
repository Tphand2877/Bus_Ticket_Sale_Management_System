<UserControl x:Class="BusTicketSaleSystem.Views.AdminBusManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:BusTicketSaleSystem.Common"
             FontFamily="{StaticResource AppFont}">

    <UserControl.Resources>
        <common:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </UserControl.Resources>

    <StackPanel Margin="0,0,0,30">
        <TextBlock Text="Bus Fleet Management" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
        <TextBlock Text="Quản lý đội xe và sơ đồ ghế tự động của từng phương tiện" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,16"/>

        <!-- Add Bus Card -->
        <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Thêm xe mới vào đội xe" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}"/>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Biển số xe (License Plate)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Plate, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Height="38"
                                 ToolTip="Ví dụ: 29B-123.45"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="8,0,8,0">
                        <TextBlock Text="Số lượng ghế" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding SeatCount, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Height="38"
                                 ToolTip="Số lượng ghế ngồi / giường nằm"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="8,0,8,0">
                        <TextBlock Text="Loại xe (Bus Type)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding BusType, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Height="38"
                                 ToolTip="Ví dụ: Ghế ngồi, Giường nằm, Limousine VIP..."/>
                    </StackPanel>

                    <Button Grid.Column="3"
                            Content="Thêm xe &amp; Sinh sơ đồ ghế"
                            Command="{Binding AddCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="38"
                            Padding="16,0"
                            VerticalAlignment="Bottom"/>
                </Grid>

                <TextBlock Text="{Binding Message}" Foreground="{StaticResource DangerBrush}" Margin="0,8,0,0" FontWeight="Medium"
                           Visibility="{Binding Message, Converter={StaticResource StringToVisibilityConverter}}"/>
            </StackPanel>
        </Border>

        <!-- Fleet List -->
        <TextBlock Text="Danh sách đội xe đang hoạt động" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
        <ItemsControl ItemsSource="{Binding Buses}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding LicensePlate}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding BusId, StringFormat='Mã xe: #{0}'}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding BusType}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding SeatCount, StringFormat='{}Quy mô: {0} chỗ'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Availability}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="Tình trạng vé đã xuất" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                            </StackPanel>

                            <Button Grid.Column="3"
                                    Content="Xóa xe"
                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Padding="14,6"
                                    FontSize="12"
                                    Foreground="{StaticResource DangerBrush}"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>

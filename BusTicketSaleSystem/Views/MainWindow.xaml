<Window x:Class="BusTicketSaleSystem.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BusTicketSaleSystem.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="OmniBus Express - Bus Ticket Sale &amp; Management System"
        Height="820" Width="1240"
        MinHeight="680" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource AppFont}">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Sidebar -->
            <ColumnDefinition Width="250"/>
            <!-- Main Content Area -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ====================================================
             LEFT SIDEBAR NAVIGATION
             ==================================================== -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}">
            <Grid Margin="18,20,18,20">
                <Grid.RowDefinitions>
                    <!-- Brand / Logo -->
                    <RowDefinition Height="Auto"/>
                    <!-- Nav Menu Items -->
                    <RowDefinition Height="*"/>
                    <!-- User Profile & Logout -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand / Logo Header -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,4,4,28">
                    <Border Width="40" Height="40" CornerRadius="10" Background="{StaticResource PrimaryBrush}" VerticalAlignment="Center">
                        <TextBlock Text="🚌" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="OmniBus" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="TICKET SYSTEM" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8"/>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Links -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="NAVIGATION"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#64748B"
                               Margin="12,0,0,10"/>

                    <!-- 🏠 Overview / Dashboard -->
                    <Button Style="{StaticResource SidebarButtonStyle}"
                            Command="{Binding NavigateHomeCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏠" FontSize="16" Width="26"/>
                            <TextBlock Text="Overview" FontSize="14" FontWeight="Medium"/>
                        </StackPanel>
                    </Button>

                    <!-- 🔍 Book a Ticket -->
                    <Button Style="{StaticResource SidebarButtonStyle}"
                            Command="{Binding NavigateBookingCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" FontSize="16" Width="26"/>
                            <TextBlock Text="Book a Ticket" FontSize="14" FontWeight="Medium"/>
                        </StackPanel>
                    </Button>

                    <!-- 🎫 My Tickets -->
                    <Button Style="{StaticResource SidebarButtonStyle}"
                            Command="{Binding NavigateMyTicketsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎫" FontSize="16" Width="26"/>
                            <TextBlock Text="My Tickets" FontSize="14" FontWeight="Medium"/>
                        </StackPanel>
                    </Button>

                    <!-- 🕘 History -->
                    <Button Style="{StaticResource SidebarButtonStyle}"
                            Command="{Binding NavigateHistoryCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🕘" FontSize="16" Width="26"/>
                            <TextBlock Text="History" FontSize="14" FontWeight="Medium"/>
                        </StackPanel>
                    </Button>

                    <!-- 👤 Account -->
                    <Button Style="{StaticResource SidebarButtonStyle}"
                            Command="{Binding NavigateProfileCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" FontSize="16" Width="26"/>
                            <TextBlock Text="Account" FontSize="14" FontWeight="Medium"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- User Profile & Logout Bottom Card -->
                <Border Grid.Row="2"
                        Background="#1E293B"
                        CornerRadius="10"
                        Padding="12"
                        BorderBrush="#334155"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Avatar Circle -->
                        <Border Grid.Column="0"
                                Width="36" Height="36"
                                CornerRadius="18"
                                Background="{StaticResource PrimaryBrush}"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserInitials}"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- User Info -->
                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserName}"
                                       Foreground="White"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding UserRole}"
                                       Foreground="#94A3B8"
                                       FontSize="11"/>
                        </StackPanel>

                        <!-- Logout Button -->
                        <Button Grid.Column="2"
                                Command="{Binding LogoutCommand}"
                                ToolTip="Sign Out"
                                Cursor="Hand"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="6">
                            <TextBlock Text="🚪" FontSize="16"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ====================================================
             MAIN CONTENT SHELL (Top bar + Central ContentControl)
             ==================================================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Top Bar -->
                <RowDefinition Height="64"/>
                <!-- Central Content -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Bar Header -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="24,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Current Section / Breadcrumb -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Dashboard / " FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding ActiveTab}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <!-- Right: Prototype Status Badge & Info -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#FEF3C7"
                                BorderBrush="#FDE68A"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="10,4"
                                Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Phase 1 Prototype Mode"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#92400E"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource PrimaryLightBrush}"
                                CornerRadius="8"
                                Padding="10,6">
                            <TextBlock Text="👤 Logged in as Alex Morgan"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource PrimaryBrush}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Central Content Control bound to CurrentViewModel -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <ContentControl Content="{Binding CurrentViewModel}"
                                Margin="24"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>

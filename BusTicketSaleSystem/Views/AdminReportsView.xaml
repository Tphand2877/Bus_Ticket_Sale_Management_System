<UserControl x:Class="BusTicketSaleSystem.Views.AdminReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BusTicketSaleSystem.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AdminReportsViewModel}"
             FontFamily="{StaticResource AppFont}">

    <StackPanel Margin="0,0,0,30">
        <!-- Header -->
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Revenue Reports" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Per-route revenue taken from the payment ledger. Only settled payments count; refunds are subtracted."
                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <TextBlock Grid.Column="1"
                       Text="{Binding RangeDescription}"
                       FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- Range selector -->
        <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="From" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                <DatePicker Grid.Column="1" SelectedDate="{Binding FromDate}" Height="36" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Column="2" Text="To" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,10,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                <DatePicker Grid.Column="3" SelectedDate="{Binding ToDate}" Height="36" VerticalContentAlignment="Center"/>

                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <Button Content="Run report"
                            Command="{Binding RunReportCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="36" Padding="18,0" Margin="0,0,8,0"/>
                    <Button Content="Last 7 days"
                            Command="{Binding LastSevenDaysCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="36" Padding="14,0" Margin="0,0,8,0"/>
                    <Button Content="Last 30 days"
                            Command="{Binding LastThirtyDaysCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="36" Padding="14,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status banner -->
        <Border Background="{StaticResource DangerLightBrush}"
                BorderBrush="{StaticResource DangerBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,0,0,16"
                Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Message}" Foreground="{StaticResource DangerBrush}" FontWeight="Medium" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="✕" Command="{Binding ClearMessageCommand}" Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource TextMutedBrush}" Cursor="Hand" FontWeight="Bold" Padding="8,2"/>
            </Grid>
        </Border>

        <!-- Busy indicator -->
        <ProgressBar Style="{StaticResource ModernProgressBarStyle}"
                     IsIndeterminate="True"
                     Margin="0,0,0,16"
                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- Totals -->
        <UniformGrid Columns="4" Margin="0,0,0,18">
            <Border Style="{StaticResource StatCardStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="NET REVENUE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding Totals.NetRevenueDisplay}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,8,0,2" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="Settled minus refunded" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCardStyle}" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="GROSS SETTLED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding Totals.GrossRevenueDisplay}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,8,0,2" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="Payments marked settled" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCardStyle}" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="REFUNDED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding Totals.RefundedAmountDisplay}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Margin="0,8,0,2" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="Paid back to customers" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatCardStyle}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="TICKETS SETTLED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding Totals.TicketsSold}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,2"/>
                    <TextBlock Text="Paid tickets in range" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Route breakdown -->
        <Border Style="{StaticResource CardStyle}" Padding="0">
            <StackPanel>
                <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="1.6*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ROUTE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="1" Text="TICKETS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="2" Text="GROSS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="3" Text="REFUNDED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="4" Text="NET" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1.6*"/>
                                        <ColumnDefinition Width="1.6*"/>
                                        <ColumnDefinition Width="1.6*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding RouteSummary}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TicketsSold}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding GrossRevenueDisplay}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{Binding RefundedAmountDisplay}" FontSize="13" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding NetRevenueDisplay}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Totals row -->
                <Border Background="#F8FAFC" Padding="18,14" Visibility="{Binding HasRows, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="1.6*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Totals.RouteSummary}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Totals.TicketsSold}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding Totals.GrossRevenueDisplay}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{Binding Totals.RefundedAmountDisplay}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="{Binding Totals.NetRevenueDisplay}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <!-- Empty state -->
                <StackPanel Visibility="{Binding HasNoRows, Converter={StaticResource BooleanToVisibilityConverter}}"
                            HorizontalAlignment="Center" Margin="0,32,0,32">
                    <TextBlock Text="📊" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="No settled payments in this date range" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Widen the range, or settle pending payments in the Payments console first."
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

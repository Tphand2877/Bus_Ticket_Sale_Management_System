<UserControl x:Class="BusTicketSaleSystem.Views.TicketView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BusTicketSaleSystem.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TicketViewModel}"
             xmlns:common="clr-namespace:BusTicketSaleSystem.Common"
             FontFamily="{StaticResource AppFont}">


    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,40" MaxWidth="780" HorizontalAlignment="Center">

            <!-- Ticket state banner. Colour is derived from Ticket.Status: it used to be
                 hard-coded success-green, so a cancelled ticket showed a green tick. -->
            <Border Background="{Binding Ticket.Status, Converter={StaticResource TicketStatusToBrush}, ConverterParameter=Surface}"
                    BorderBrush="{Binding Ticket.Status, Converter={StaticResource TicketStatusToBrush}, ConverterParameter=Border}"
                    BorderThickness="1" CornerRadius="12" Padding="20,16" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22"
                            Background="{Binding Ticket.Status, Converter={StaticResource TicketStatusToBrush}, ConverterParameter=Accent}"
                            VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding StateGlyph}"
                                   Foreground="White" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StateHeadline}" FontSize="17" FontWeight="Bold"
                                   Foreground="{Binding Ticket.Status, Converter={StaticResource TicketStatusToBrush}, ConverterParameter=Accent}"/>
                        <TextBlock Text="{Binding StateDetail}"
                                   FontSize="13" Margin="0,3,0,0" TextWrapping="Wrap"
                                   Foreground="{Binding Ticket.Status, Converter={StaticResource TicketStatusToBrush}, ConverterParameter=Accent}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- BOARDING PASS CARD -->
            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="18" Effect="{StaticResource ElevatedShadow}">
                <StackPanel>
                    <!-- Ticket Header / Navy Ribbon -->
                    <Border Background="#1E3A8A" CornerRadius="18,18,0,0" Padding="28,22">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="32" Height="32" CornerRadius="8" Background="#2563EB" Margin="0,0,10,0">
                                        <Path Data="{StaticResource IconBus}" Fill="White" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="OmniBus Express" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                        <TextBlock Text="OFFICIAL BOARDING PASS" Foreground="#93C5FD" FontSize="10" FontWeight="Bold" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- Ticket Code Pill -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="TICKET CODE" Foreground="#93C5FD" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                <Border Background="#172554" CornerRadius="8" Padding="12,5" Margin="0,4,0,0" BorderBrush="#3B82F6" BorderThickness="1">
                                    <TextBlock Text="{Binding Ticket.TicketCode}" Foreground="White" FontSize="15" FontWeight="Bold" FontFamily="Consolas, Segoe UI"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Route Origin -> Destination Display -->
                    <Border Padding="32,28,32,20" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Origin -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="DEPARTURE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding Ticket.Origin}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,2"/>
                                <TextBlock Text="{Binding Ticket.DepartureTime, StringFormat={}{0:HH:mm - dddd, dd/MM/yyyy}}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                            </StackPanel>

                            <!-- Route Transit Indicator -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,0">
                                <Path Data="{StaticResource IconRoute}" Fill="{StaticResource PrimaryBrush}" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Ticket.Route}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Destination -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                <TextBlock Text="DESTINATION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding Ticket.Destination}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,2" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding Ticket.ArrivalTime, StringFormat={}{0:HH:mm - dddd, dd/MM/yyyy}}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Perforated Tear-Off Divider -->
                    <Grid Margin="0,-1,0,0">
                        <!-- Left cutout notch -->
                        <Border Width="20" Height="20" CornerRadius="0,10,10,0" Background="{StaticResource BackgroundBrush}" HorizontalAlignment="Left" Margin="-1,0,0,0"/>
                        <!-- Dashed line -->
                        <Line X1="0" Y1="10" X2="740" Y2="10" Stroke="#CBD5E1" StrokeDashArray="4 4" StrokeThickness="1.5" HorizontalAlignment="Center" Width="720"/>
                        <!-- Right cutout notch -->
                        <Border Width="20" Height="20" CornerRadius="10,0,0,10" Background="{StaticResource BackgroundBrush}" HorizontalAlignment="Right" Margin="0,0,-1,0"/>
                    </Grid>

                    <!-- Ticket Details Grid -->
                    <Border Padding="32,24,32,28">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 1: Vehicle, Seat & Fare -->
                            <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,24">
                                <!-- Bus Type -->
                                <StackPanel>
                                    <TextBlock Text="BUS COACH" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding Ticket.BusType}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- Seats -->
                                <StackPanel>
                                    <TextBlock Text="{Binding Ticket.SeatCount, StringFormat=ASSIGNED SEATS ({0})}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10,3" HorizontalAlignment="Left" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Ticket.SeatNumbers}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>

                                <!-- Status -->
                                <StackPanel>
                                    <TextBlock Text="STATUS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <Border Background="{Binding Ticket.Status, Converter={StaticResource TicketStatusToBrush}, ConverterParameter=Surface}"
                                            BorderBrush="{Binding Ticket.Status, Converter={StaticResource TicketStatusToBrush}, ConverterParameter=Border}"
                                            BorderThickness="1" CornerRadius="12" Padding="10,3" HorizontalAlignment="Left" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Ticket.Status, Converter={StaticResource TicketStatusToDisplay}}"
                                                   FontSize="12" FontWeight="Bold"
                                                   Foreground="{Binding Ticket.Status, Converter={StaticResource TicketStatusToBrush}, ConverterParameter=Accent}"/>
                                    </Border>
                                </StackPanel>

                                <!-- Total Paid -->
                                <StackPanel HorizontalAlignment="Right">
                                    <TextBlock Text="TOTAL FARE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding Ticket.TotalPrice, StringFormat={}{0:N0} VND}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </UniformGrid>

                            <!-- Row 2: Booking Timestamp & Terms -->
                            <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,0,24">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Issued via OmniBus Digital Terminal" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Ticket.BookingTime, StringFormat=Issued on {0:dd/MM/yyyy HH:mm:ss}}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconShield}" Fill="{StaticResource SuccessBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,6,0"/>
                                        <TextBlock Text="Verified &amp; Insured" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Row 3: Barcode & Digital Validation Simulation -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Simulated Barcode -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <Border Height="46" Background="Transparent" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Barcode stripes -->
                                            <Rectangle Width="3" Height="46" Fill="#0F172A" Margin="0,0,2,0"/>
                                            <Rectangle Width="2" Height="46" Fill="#0F172A" Margin="0,0,4,0"/>
                                            <Rectangle Width="5" Height="46" Fill="#0F172A" Margin="0,0,2,0"/>
                                            <Rectangle Width="1" Height="46" Fill="#0F172A" Margin="0,0,3,0"/>
                                            <Rectangle Width="4" Height="46" Fill="#0F172A" Margin="0,0,2,0"/>
                                            <Rectangle Width="2" Height="46" Fill="#0F172A" Margin="0,0,5,0"/>
                                            <Rectangle Width="6" Height="46" Fill="#0F172A" Margin="0,0,2,0"/>
                                            <Rectangle Width="3" Height="46" Fill="#0F172A" Margin="0,0,3,0"/>
                                            <Rectangle Width="1" Height="46" Fill="#0F172A" Margin="0,0,4,0"/>
                                            <Rectangle Width="4" Height="46" Fill="#0F172A" Margin="0,0,2,0"/>
                                            <Rectangle Width="2" Height="46" Fill="#0F172A" Margin="0,0,3,0"/>
                                            <Rectangle Width="5" Height="46" Fill="#0F172A" Margin="0,0,2,0"/>
                                            <Rectangle Width="3" Height="46" Fill="#0F172A" Margin="0,0,4,0"/>
                                            <Rectangle Width="1" Height="46" Fill="#0F172A" Margin="0,0,2,0"/>
                                            <Rectangle Width="4" Height="46" Fill="#0F172A" Margin="0,0,3,0"/>
                                            <Rectangle Width="2" Height="46" Fill="#0F172A" Margin="0,0,2,0"/>
                                            <Rectangle Width="6" Height="46" Fill="#0F172A" Margin="0,0,3,0"/>
                                            <Rectangle Width="3" Height="46" Fill="#0F172A" Margin="0,0,2,0"/>
                                            <Rectangle Width="2" Height="46" Fill="#0F172A" Margin="0,0,4,0"/>
                                            <Rectangle Width="5" Height="46" Fill="#0F172A" Margin="0,0,2,0"/>
                                            <Rectangle Width="1" Height="46" Fill="#0F172A" Margin="0,0,3,0"/>
                                            <Rectangle Width="4" Height="46" Fill="#0F172A" Margin="0,0,2,0"/>
                                            <Rectangle Width="2" Height="46" Fill="#0F172A" Margin="0,0,4,0"/>
                                            <Rectangle Width="3" Height="46" Fill="#0F172A" Margin="0,0,1,0"/>
                                            <Rectangle Width="5" Height="46" Fill="#0F172A" Margin="0,0,3,0"/>
                                            <Rectangle Width="2" Height="46" Fill="#0F172A"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{Binding Ticket.TicketCode, StringFormat=*{0}*}"
                                               FontFamily="Consolas, Segoe UI"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- Dynamic QR generated from the actual ticket code -->
                                <Border Grid.Column="1" Width="80" Height="80" Background="#F1F5F9" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6" HorizontalAlignment="Right">
                                    <Image Source="{Binding QrCodeImage}" Stretch="Uniform"/>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Ticket actions -->
            <WrapPanel HorizontalAlignment="Center" Margin="0,24,0,0">
                <Button Content="Print ticket"
                        Command="{Binding PrintTicketCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Height="42"
                        Padding="18,0"
                        Margin="0,0,10,10"/>
                <Button Content="Export PNG"
                        Command="{Binding ExportPngCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Height="42"
                        Padding="18,0"
                        Margin="0,0,10,10"/>
                <Button Content="Export PDF"
                        Command="{Binding ExportPdfCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Height="42"
                        Padding="18,0"
                        Margin="0,0,10,10"/>
                <Button Content="View route on map"
                        Command="{Binding ViewRouteOnMapCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Height="42"
                        Padding="18,0"
                        Margin="0,0,10,10"/>
                <Button Content="Email PDF ticket"
                        Command="{Binding EmailTicketCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="42"
                        Padding="18,0"
                        Margin="0,0,0,10"
                        ToolTip="{Binding EmailAvailabilityNote}"/>
            </WrapPanel>

            <TextBlock Text="{Binding EmailAvailabilityNote}"
                       FontSize="12"
                       Foreground="{StaticResource TextMutedBrush}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,4"/>

            <ProgressBar Height="4"
                         Margin="0,10,0,0"
                         IsIndeterminate="True"
                         Style="{StaticResource ModernProgressBarStyle}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <!-- Action feedback -->
            <Border Background="{StaticResource PrimaryLightBrush}"
                    BorderBrush="{StaticResource PrimaryTintBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="0,12,0,0"
                    Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}">
                <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="{StaticResource PrimaryBrush}" FontWeight="Medium" TextWrapping="Wrap"/>
            </Border>
            <Border Background="{StaticResource DangerLightBrush}"
                    BorderBrush="{StaticResource DangerBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10"
                    Margin="0,12,0,0"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" FontSize="13" Foreground="{StaticResource DangerBrush}" FontWeight="Medium" TextWrapping="Wrap"/>
            </Border>

            <!-- Navigation Buttons -->
            <Grid Margin="0,28,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Command="{Binding BackToOverviewCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Height="46"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconArrowLeft}" Fill="{StaticResource PrimaryBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Back to Overview" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="1"
                        Command="{Binding BackToMyTicketsCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="46"
                        Margin="10,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconTicket}" Fill="White" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="View in My Tickets" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>

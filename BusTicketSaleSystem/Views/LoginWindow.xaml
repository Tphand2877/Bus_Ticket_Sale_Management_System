<Window x:Class="BusTicketSaleSystem.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OmniBus Express - Sign In"
        Height="580" Width="880"
        MinHeight="540" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource AppFont}">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Branding Hero (42%) -->
            <ColumnDefinition Width="380"/>
            <!-- Right Login Form (58%) -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ====================================================
             LEFT BRANDING HERO PANEL
             ==================================================== -->
        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0B1329" Offset="0"/>
                    <GradientStop Color="#1E3A8A" Offset="0.6"/>
                    <GradientStop Color="#1D4ED8" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid Margin="36,40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0">
                    <Border Width="48" Height="48"
                            CornerRadius="12"
                            Background="#2563EB"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,16">
                        <Path Data="{StaticResource IconBus}"
                              Fill="White"
                              Width="26" Height="26"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="OmniBus"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Text="EXPRESS TRANSIT"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#38BDF8"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Brand Highlights / Feature List -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,20">
                    <TextBlock Text="Your journey starts here."
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Fast, comfortable, and reliable intercity travel booking."
                               FontSize="13"
                               Foreground="#93C5FD"
                               TextWrapping="Wrap"
                               Margin="0,0,0,24"/>

                    <!-- Feature 1 -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="22" Height="22" CornerRadius="11" Background="#1E40AF" Margin="0,0,12,0">
                            <Path Data="{StaticResource IconCheck}" Fill="#60A5FA" Width="12" Height="12" Stretch="Uniform"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="Live interactive seat selection" Foreground="#E2E8F0" FontSize="13" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Feature 2 -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="22" Height="22" CornerRadius="11" Background="#1E40AF" Margin="0,0,12,0">
                            <Path Data="{StaticResource IconCheck}" Fill="#60A5FA" Width="12" Height="12" Stretch="Uniform"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="Instant digital e-boarding pass" Foreground="#E2E8F0" FontSize="13" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Feature 3 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="22" Height="22" CornerRadius="11" Background="#1E40AF" Margin="0,0,12,0">
                            <Path Data="{StaticResource IconCheck}" Fill="#60A5FA" Width="12" Height="12" Stretch="Uniform"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="Verified schedules &amp; fixed pricing" Foreground="#E2E8F0" FontSize="13" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>

                <!-- Footer Trust Badge -->
                <Border Grid.Row="2"
                        Background="#0F172A"
                        CornerRadius="8"
                        Padding="14,10"
                        Opacity="0.85">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconShield}" Fill="#38BDF8" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Secure 256-bit encrypted authentication" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ====================================================
             RIGHT SIGN-IN FORM PANEL
             ==================================================== -->
        <Border Grid.Column="1" Background="{StaticResource SurfaceCardBrush}" Padding="48,36">
            <Grid VerticalAlignment="Center" MaxWidth="380">
                <StackPanel>
                    <!-- Form Title -->
                    <TextBlock Text="Sign In"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Enter your account credentials to continue"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,4,0,24"/>

                    <!-- Error Alert Banner -->
                    <Border x:Name="ErrorContainer"
                            Background="{StaticResource DangerLightBrush}"
                            BorderBrush="{StaticResource DangerBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="0,0,0,16"
                            Visibility="{Binding Visibility, ElementName=TxtError}">
                        <TextBlock x:Name="TxtError"
                                   Foreground="{StaticResource DangerBrush}"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"/>
                    </Border>

                    <!-- Username / Email Field -->
                    <TextBlock Text="Username or Email"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtUsername"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Text="alex.morgan@busxpress.com"
                             Height="42"
                             Margin="0,0,0,16"/>

                    <!-- Password Field -->
                    <TextBlock Text="Password"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,6"/>
                    <PasswordBox x:Name="TxtPassword"
                                 Style="{StaticResource ModernPasswordBoxStyle}"
                                 Password="password123"
                                 Height="42"
                                 Margin="0,0,0,20"/>

                    <!-- Remember Me -->
                    <Grid Margin="0,0,0,22">
                        <CheckBox Content="Remember my session"
                                  IsChecked="True"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  FontSize="13"
                                  VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Sign In Primary Button -->
                    <Button x:Name="BtnLogin"
                            Content="Sign In to Account"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="44"
                            Click="LoginButton_Click"/>

                    <!-- Divider -->
                    <Grid Margin="0,20,0,16">
                        <Separator Background="{StaticResource BorderBrush}"/>
                        <TextBlock Text="OR"
                                   Background="White"
                                   Padding="10,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11"
                                   FontWeight="SemiBold"/>
                    </Grid>

                    <!-- Create New Account Button -->
                    <Button Content="Create New Account"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="40"
                            Click="SignUpButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

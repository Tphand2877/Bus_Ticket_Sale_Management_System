<UserControl x:Class="BusTicketSaleSystem.Views.AdminTripManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:BusTicketSaleSystem.Common"
             FontFamily="{StaticResource AppFont}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <common:BooleanToVisibilityInvertedConverter x:Key="BooleanToVisibilityInvertedConverter"/>
        <common:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </UserControl.Resources>

    <StackPanel Margin="0,0,0,30">
        <TextBlock Text="Trip Schedule Management" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
        <TextBlock Text="Thiết lập lịch trình khởi hành, gán xe và định giá vé chuyến xe liên tỉnh" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,16"/>

        <!-- Form Card (Add / Edit) -->
        <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,20">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <TextBlock Text="Thêm chuyến xe mới" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}"
                               Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityInvertedConverter}}"/>
                    <TextBlock Text="Chỉnh sửa lịch trình chuyến xe" FontWeight="Bold" FontSize="16" Foreground="{StaticResource PrimaryBrush}"
                               Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Route Selector -->
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Tuyến đường" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Routes}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="RouteId"
                                  SelectedValue="{Binding SelectedRouteId}"
                                  Height="38"
                                  IsEnabled="{Binding IsEditing, Converter={StaticResource InverseBooleanConverter}}"/>
                    </StackPanel>

                    <!-- Bus Selector -->
                    <StackPanel Grid.Column="1" Margin="8,0,8,0">
                        <TextBlock Text="Xe phục vụ" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Buses}"
                                  DisplayMemberPath="LicensePlate"
                                  SelectedValuePath="BusId"
                                  SelectedValue="{Binding SelectedBusId}"
                                  Height="38"
                                  IsEnabled="{Binding IsEditing, Converter={StaticResource InverseBooleanConverter}}"/>
                    </StackPanel>

                    <!-- Departure Time -->
                    <StackPanel Grid.Column="2" Margin="8,0,8,0">
                        <TextBlock Text="Khởi hành" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Departure, StringFormat={}{0:yyyy-MM-dd HH:mm}, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Height="38"/>
                    </StackPanel>

                    <!-- Arrival Time -->
                    <StackPanel Grid.Column="3" Margin="8,0,8,0">
                        <TextBlock Text="Đến nơi" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Arrival, StringFormat={}{0:yyyy-MM-dd HH:mm}, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Height="38"/>
                    </StackPanel>

                    <!-- Price -->
                    <StackPanel Grid.Column="4" Margin="8,0,8,0">
                        <TextBlock Text="Giá vé (VND)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Height="38"/>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Content="Thêm chuyến"
                                Command="{Binding AddCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="38"
                                Padding="16,0"
                                Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityInvertedConverter}}"/>

                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button Content="Lưu cập nhật"
                                    Command="{Binding UpdateCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Height="38"
                                    Padding="14,0"
                                    Margin="0,0,8,0"/>
                            <Button Content="Hủy"
                                    Command="{Binding CancelEditCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Height="38"
                                    Padding="12,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Định dạng thời gian: yyyy-MM-dd HH:mm (Ví dụ: 2026-09-20 08:30)" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                <TextBlock Text="{Binding Message}" Foreground="{StaticResource DangerBrush}" Margin="0,6,0,0" FontWeight="Medium"
                           Visibility="{Binding Message, Converter={StaticResource StringToVisibilityConverter}}"/>
            </StackPanel>
        </Border>

        <!-- Trips List Table -->
        <TextBlock Text="Danh sách chuyến xe hiện tại" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
        <ItemsControl ItemsSource="{Binding Trips}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.5*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Route}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding LicensePlate, StringFormat='Xe: {0}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Schedule}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Lịch trình" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PriceDisplay}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="Giá vé" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Sửa"
                                        Command="{Binding DataContext.SelectForEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="12,5"
                                        FontSize="12"
                                        Margin="0,0,8,0"/>
                                <Button Content="Xóa"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Padding="12,5"
                                        FontSize="12"
                                        Foreground="{StaticResource DangerBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>

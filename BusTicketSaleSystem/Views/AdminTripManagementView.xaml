<UserControl x:Class="BusTicketSaleSystem.Views.AdminTripManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BusTicketSaleSystem.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AdminTripManagementViewModel}"
             FontFamily="{StaticResource AppFont}">

    <StackPanel Margin="0,0,0,30">
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Trip Schedule Management" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Plan departures, assign a bus to a route and set the fare." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Content="Refresh"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Height="38" Padding="16,0" VerticalAlignment="Center"/>
        </Grid>

        <!-- Station Scoping Banner -->
        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="{StaticResource IconPin}" Fill="{StaticResource PrimaryBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding StationScopeDisplay}" FontWeight="Bold" FontSize="13" Foreground="#1E40AF" VerticalAlignment="Center"/>
                <TextBlock Text=" · Chỉ hiển thị và điều hành các chuyến xe trong phạm vi bến xe này." FontSize="12.5" Foreground="#3B82F6" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </StackPanel>
        </Border>
        <!-- Form Card (Add / Edit) -->
        <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,20">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <TextBlock Text="Schedule a new trip" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}"
                               Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityInvertedConverter}}"/>
                    <TextBlock Text="Edit trip" FontWeight="Bold" FontSize="16" Foreground="{StaticResource PrimaryBrush}"
                               Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Route Selector -->
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Route" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Routes}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="RouteId"
                                  SelectedValue="{Binding SelectedRouteId}"
                                  Height="38"/>
                    </StackPanel>

                    <!-- Bus Selector -->
                    <StackPanel Grid.Column="1" Margin="8,0,8,0">
                        <TextBlock Text="Assigned bus" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Buses}"
                                  DisplayMemberPath="LicensePlate"
                                  SelectedValuePath="BusId"
                                  SelectedValue="{Binding SelectedBusId}"
                                  Height="38"/>
                    </StackPanel>

                    <!-- Departure Time -->
                    <StackPanel Grid.Column="2" Margin="8,0,8,0">
                        <TextBlock Text="Departure" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Departure, StringFormat={}{0:yyyy-MM-dd HH:mm}, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Height="38"/>
                    </StackPanel>

                    <!-- Arrival Time -->
                    <StackPanel Grid.Column="3" Margin="8,0,8,0">
                        <TextBlock Text="Arrival" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Arrival, StringFormat={}{0:yyyy-MM-dd HH:mm}, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Height="38"/>
                    </StackPanel>

                    <!-- Price -->
                    <StackPanel Grid.Column="4" Margin="8,0,8,0">
                        <TextBlock Text="Fare (VND)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Height="38"/>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Content="Add trip"
                                Command="{Binding AddCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="38"
                                Padding="16,0"
                                Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityInvertedConverter}}"/>

                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button Content="Save changes"
                                    Command="{Binding UpdateCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Height="38"
                                    Padding="14,0"
                                    Margin="0,0,8,0"/>
                            <Button Content="Cancel"
                                    Command="{Binding CancelEditCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Height="38"
                                    Padding="12,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Time format: yyyy-MM-dd HH:mm (for example 2026-09-20 08:30). A trip can only move to another bus while it has no tickets."
                           Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                <TextBlock Text="{Binding Message}" Foreground="{StaticResource PrimaryBrush}" Margin="0,6,0,0" FontWeight="Medium" TextWrapping="Wrap"
                           Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </Border>

        <!-- Delete confirmation -->
        <Border Background="{StaticResource DangerLightBrush}"
                BorderBrush="{StaticResource DangerBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12"
                Margin="0,0,0,16"
                Visibility="{Binding IsConfirmingDelete, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding DeleteConfirmationPrompt}" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Confirm delete"
                            Command="{Binding ConfirmDeleteCommand}"
                            Style="{StaticResource DangerButtonStyle}"
                            Height="34" Padding="14,0" Margin="12,0,8,0"/>
                    <Button Content="Keep trip"
                            Command="{Binding CancelDeleteCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="34" Padding="12,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Busy indicator -->
        <ProgressBar Style="{StaticResource ModernProgressBarStyle}"
                     IsIndeterminate="True"
                     Margin="0,0,0,14"
                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- Trips List Table -->
        <TextBlock Text="Danh sách chuyến xe đã lên lịch" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
        <ItemsControl ItemsSource="{Binding Trips}"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.5*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Route}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <Border CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                                            Background="{Binding IsCancelled, Converter={StaticResource BooleanToBrushConverter}, ConverterParameter='#FEE2E2|#ECFDF5'}">
                                        <TextBlock Text="{Binding StatusDisplay}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{Binding IsCancelled, Converter={StaticResource BooleanToBrushConverter}, ConverterParameter='#DC2626|#059669'}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding LicensePlate, StringFormat='Bus: {0}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Schedule}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Schedule" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PriceDisplay}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="Fare" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Hủy chuyến"
                                        Command="{Binding DataContext.CancelTripCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding CanCancel, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Padding="12,5"
                                        FontSize="12"
                                        Foreground="{StaticResource WarningBrush}"
                                        Margin="0,0,8,0"/>
                                <Button Content="Edit"
                                        Command="{Binding DataContext.SelectForEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="14,5"
                                        FontSize="12"
                                        Margin="0,0,8,0"/>
                                <Button Content="Delete"
                                        Command="{Binding DataContext.RequestDeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Padding="14,5"
                                        FontSize="12"
                                        Foreground="{StaticResource DangerBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Empty state -->
        <Border Style="{StaticResource CardStyle}" Padding="24"
                Visibility="{Binding HasNoTrips, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="🕒" FontSize="30" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="No trips scheduled yet" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Pick a route and bus above to publish the first departure."
                           FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

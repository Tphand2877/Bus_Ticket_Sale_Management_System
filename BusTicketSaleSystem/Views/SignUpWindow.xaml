<Window x:Class="BusTicketSaleSystem.Views.SignUpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Account - OmniBus Express"
        Height="720" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource AppFont}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,28">
            <Border Style="{StaticResource ElevatedCardStyle}" Padding="36,32">
                <StackPanel>
                    <!-- Brand Header -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
                        <Border Width="48" Height="48"
                                CornerRadius="12"
                                Background="{StaticResource PrimaryBrush}"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,12">
                            <Path Data="{StaticResource IconUser}"
                                  Fill="White"
                                  Width="22" Height="22"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Create Your Account"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Join OmniBus Express to book &amp; manage your tickets"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Error Alert -->
                    <Border Background="{StaticResource DangerLightBrush}"
                            BorderBrush="{StaticResource DangerBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="0,0,0,16"
                            Visibility="{Binding Visibility, ElementName=TxtError}">
                        <TextBlock x:Name="TxtError"
                                   Foreground="{StaticResource DangerBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Visibility="Collapsed"/>
                    </Border>

                    <!-- Full Name -->
                    <TextBlock Text="Full Name *"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtFullName"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Height="40"
                             Margin="0,0,0,14"/>

                    <!-- Username -->
                    <TextBlock Text="Username *"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtUsername"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Height="40"
                             Margin="0,0,0,14"/>

                    <!-- 2-Column Row for Contact Info -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Email -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Email (optional)"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtEmail"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     Height="40"/>
                        </StackPanel>

                        <!-- Phone -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Phone (optional)"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtPhone"
                                     Style="{StaticResource ModernTextBoxStyle}"
                                     Height="40"/>
                        </StackPanel>
                    </Grid>

                    <!-- Password -->
                    <TextBlock Text="Password * (Minimum 8 characters)"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Margin="0,0,0,5"/>
                    <PasswordBox x:Name="TxtPassword"
                                 Style="{StaticResource ModernPasswordBoxStyle}"
                                 Height="40"
                                 Margin="0,0,0,14"/>

                    <!-- Confirm Password -->
                    <TextBlock Text="Confirm Password *"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Margin="0,0,0,5"/>
                    <PasswordBox x:Name="TxtConfirmPassword"
                                 Style="{StaticResource ModernPasswordBoxStyle}"
                                 Height="40"
                                 Margin="0,0,0,24"/>

                    <!-- Submit Button -->
                    <Button x:Name="BtnCreate"
                            Content="Register Account"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="44"
                            Click="CreateAccountButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>

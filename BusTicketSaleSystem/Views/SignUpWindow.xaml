<Window x:Class="BusTicketSaleSystem.Views.SignUpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="clr-namespace:BusTicketSaleSystem.Common"
        Title="Create Account - OmniBus Express"
        Height="720" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource AppFont}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,28">
            <Border Style="{StaticResource ElevatedCardStyle}" Padding="36,32">
                <StackPanel>
                    <!-- Brand Header -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
                        <Border Width="48" Height="48"
                                CornerRadius="12"
                                Background="{StaticResource PrimaryBrush}"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,12">
                            <Path Data="{StaticResource IconUser}"
                                  Fill="White"
                                  Width="22" Height="22"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Create Your Account"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Join OmniBus Express to book &amp; manage your tickets"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Error Alert -->
                    <Border Background="{StaticResource DangerLightBrush}"
                            BorderBrush="{StaticResource DangerBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="0,0,0,16"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{StaticResource DangerBrush}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   FontWeight="Medium"/>
                    </Border>

                    <!-- Full Name -->
                    <TextBlock Text="Full Name *"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Margin="0,0,0,5"/>
                    <TextBox Style="{StaticResource ModernTextBoxStyle}"
                             Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                             Height="40"
                             Margin="0,0,0,14"/>

                    <!-- Username -->
                    <TextBlock Text="Username *"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Margin="0,0,0,5"/>
                    <TextBox Style="{StaticResource ModernTextBoxStyle}"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             Height="40"
                             Margin="0,0,0,14"/>

                    <!-- 2-Column Row for Contact Info -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Email -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Email (optional)"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Margin="0,0,0,5"/>
                            <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                     Height="40"/>
                        </StackPanel>

                        <!-- Phone -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Phone (optional)"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Margin="0,0,0,5"/>
                            <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                     Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="15"
                                     common:TextInputRestrictions.PhoneNumber="True"
                                     Height="40"/>
                        </StackPanel>
                    </Grid>

                    <!-- Password -->
                    <TextBlock Text="Password * (Minimum 8 characters)"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Margin="0,0,0,5"/>
                    <PasswordBox x:Name="TxtPassword"
                                 Tag="Password"
                                 PasswordChanged="PasswordBox_OnPasswordChanged"
                                 Style="{StaticResource ModernPasswordBoxStyle}"
                                 Height="40"
                                 Margin="0,0,0,14"/>

                    <!-- Confirm Password -->
                    <TextBlock Text="Confirm Password *"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Margin="0,0,0,5"/>
                    <PasswordBox x:Name="TxtConfirmPassword"
                                 Tag="ConfirmPassword"
                                 PasswordChanged="PasswordBox_OnPasswordChanged"
                                 Style="{StaticResource ModernPasswordBoxStyle}"
                                 Height="40"
                                 Margin="0,0,0,24"/>

                    <!-- Submit Button (Enter submits) -->
                    <Button Content="Register Account"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="44"
                            IsDefault="True"
                            Command="{Binding CreateAccountCommand}"/>

                    <Button Content="Back to Sign In"
                            Style="{StaticResource GhostButtonStyle}"
                            Height="38"
                            Margin="0,10,0,0"
                            IsCancel="True"
                            Command="{Binding CancelCommand}"/>

                    <ProgressBar Height="4"
                                 Margin="0,12,0,0"
                                 IsIndeterminate="True"
                                 Style="{StaticResource ModernProgressBarStyle}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>

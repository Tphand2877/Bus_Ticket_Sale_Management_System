<UserControl x:Class="BusTicketSaleSystem.Views.AdminAccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:common="clr-namespace:BusTicketSaleSystem.Common"
             xmlns:vm="clr-namespace:BusTicketSaleSystem.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AdminAccountsViewModel}"
             FontFamily="{StaticResource AppFont}">

    <UserControl.Resources>
        <common:TabActiveBrushConverter x:Key="RoleBgConverter" ActiveBrush="#EFF6FF" InactiveBrush="#F1F5F9"/>
        <common:TabActiveTextBrushConverter x:Key="RoleFgConverter" ActiveBrush="#1D4ED8" InactiveBrush="#475569"/>
    </UserControl.Resources>

    <StackPanel Margin="0,0,0,30">
        <!-- Header -->
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="User Account Management" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Manage accounts, switch between the customer and administrator roles, reset passwords and remove unused accounts."
                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Refresh"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="16,8"
                    VerticalAlignment="Center"/>
        </Grid>

        <!-- Search Bar -->
        <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Search" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox Grid.Column="1"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Height="38"
                         ToolTip="Username, full name, email or phone"/>
            </Grid>
        </Border>

        <!-- Status / Feedback Banner -->
        <Border Background="{StaticResource PrimaryLightBrush}"
                BorderBrush="{StaticResource PrimaryTintBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,8"
                Margin="0,0,0,16"
                Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding Message}" Foreground="{StaticResource PrimaryBrush}" FontWeight="Medium" FontSize="13" TextWrapping="Wrap"/>
        </Border>

        <!-- Password reset panel -->
        <Border Style="{StaticResource CardStyle}"
                Padding="18"
                Margin="0,0,0,16"
                Visibility="{Binding IsResettingPassword, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="Reset password" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding PasswordResetPrompt}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,12" TextWrapping="Wrap"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Height="38"
                             ToolTip="Temporary password handed to the account owner"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                        <Button Content="Apply new password"
                                Command="{Binding ApplyPasswordResetCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="38" Padding="16,0" Margin="0,0,8,0"/>
                        <Button Content="Cancel"
                                Command="{Binding CancelPasswordResetCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="38" Padding="12,0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Delete confirmation -->
        <Border Background="{StaticResource DangerLightBrush}"
                BorderBrush="{StaticResource DangerBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12"
                Margin="0,0,0,16"
                Visibility="{Binding IsConfirmingDelete, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding DeleteConfirmationPrompt}" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Confirm delete"
                            Command="{Binding ConfirmDeleteCommand}"
                            Style="{StaticResource DangerButtonStyle}"
                            Height="34" Padding="14,0" Margin="12,0,8,0"/>
                    <Button Content="Keep account"
                            Command="{Binding CancelDeleteCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="34" Padding="12,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Busy indicator -->
        <ProgressBar Style="{StaticResource ModernProgressBarStyle}"
                     IsIndeterminate="True"
                     Margin="0,0,0,14"
                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- Accounts List Table -->
        <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,16">
            <StackPanel>
                <!-- Table Header -->
                <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ID" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="1" Text="USERNAME" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="2" Text="FULL NAME" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="3" Text="EMAIL" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="4" Text="PHONE" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="5" Text="ROLE" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="6" Text="ACTIONS" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <!-- Table Rows -->
                <ItemsControl ItemsSource="{Binding Accounts}"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding AccountId, StringFormat='#{0}'}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Username}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding FullName}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Email, TargetNullValue='—'}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Phone, TargetNullValue='—'}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>

                                    <Border Grid.Column="5" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Background="{Binding Role, Converter={StaticResource RoleBgConverter}, ConverterParameter=Admin}">
                                        <TextBlock Text="{Binding RoleBadge}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{Binding Role, Converter={StaticResource RoleFgConverter}, ConverterParameter=Admin}"/>
                                    </Border>

                                    <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="{Binding ToggleRoleCaption}"
                                                Command="{Binding DataContext.ToggleRoleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="12,5"
                                                FontSize="12"
                                                Margin="0,0,8,0"/>
                                        <Button Content="Reset password"
                                                Command="{Binding DataContext.BeginPasswordResetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Padding="12,5"
                                                FontSize="12"
                                                Margin="0,0,8,0"/>
                                        <Button Content="Delete"
                                                Command="{Binding DataContext.RequestDeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource GhostButtonStyle}"
                                                Padding="12,5"
                                                FontSize="12"
                                                Foreground="{StaticResource DangerBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Empty state -->
                <StackPanel Visibility="{Binding HasNoAccounts, Converter={StaticResource BooleanToVisibilityConverter}}"
                            HorizontalAlignment="Center" Margin="0,30,0,30">
                    <TextBlock Text="👤" FontSize="30" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="No accounts match the search" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Clear the search box to list every registered account."
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

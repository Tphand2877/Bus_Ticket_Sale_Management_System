<UserControl x:Class="BusTicketSaleSystem.Views.AdminPaymentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BusTicketSaleSystem.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AdminPaymentsViewModel}"
             FontFamily="{StaticResource AppFont}">

    <UserControl.Resources>
        <Style x:Key="LedgerBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Pending">
                    <Setter Property="Background" Value="#FFFBEB"/>
                    <Setter Property="BorderBrush" Value="#FDE68A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Success">
                    <Setter Property="Background" Value="#ECFDF5"/>
                    <Setter Property="BorderBrush" Value="#A7F3D0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter Property="Background" Value="#FEF2F2"/>
                    <Setter Property="BorderBrush" Value="#FECACA"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Refunded">
                    <Setter Property="Background" Value="#EFF6FF"/>
                    <Setter Property="BorderBrush" Value="#BFDBFE"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LedgerBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Pending">
                    <Setter Property="Foreground" Value="#B45309"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Success">
                    <Setter Property="Foreground" Value="#065F46"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter Property="Foreground" Value="#B91C1C"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Refunded">
                    <Setter Property="Foreground" Value="#1D4ED8"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="0,0,0,30">
        <!-- Header -->
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Payments &amp; Settlement" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Confirm bank transfers and cash collection, reject abandoned holds, approve refunds and check passengers in."
                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Height="38" Padding="14,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource PrimaryBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Refresh" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Ledger summary strip -->
        <UniformGrid Columns="5" Margin="0,0,0,18">
            <Border Style="{StaticResource StatCardStyle}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="AWAITING SETTLEMENT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding Stats.PendingAmountDisplay}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" Margin="0,8,0,2" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Stats.PendingCount, StringFormat='{}{0} pending payment(s)'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCardStyle}" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="SETTLED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding Stats.SuccessAmountDisplay}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,8,0,2" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Stats.SuccessCount, StringFormat='{}{0} settled payment(s)'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCardStyle}" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="REFUNDED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding Stats.RefundedAmountDisplay}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,8,0,2" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Stats.RefundedCount, StringFormat='{}{0} refund(s) paid back'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCardStyle}" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="FAILED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding Stats.FailedAmountDisplay}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Margin="0,8,0,2" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Stats.FailedCount, StringFormat='{}{0} rejected or expired'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource StatCardStyle}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="NET REVENUE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding Stats.NetRevenueDisplay}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,2" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="Settled minus refunded" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Filters -->
        <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Ledger status" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding StatusFilters}"
                          SelectedItem="{Binding SelectedStatusFilter}"
                          Height="38"
                          VerticalContentAlignment="Center">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource PaymentStatusToDisplay}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Grid.Column="2" Text="Search" FontWeight="SemiBold" VerticalAlignment="Center" Margin="18,0,10,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox Grid.Column="3"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Height="38"
                         ToolTip="Ticket code, transaction number, passenger name or phone">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <Button Grid.Column="4"
                        Content="Search"
                        Command="{Binding SearchCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="38" Padding="18,0" Margin="10,0,0,0"/>
            </Grid>
        </Border>

        <!-- Status banner -->
        <Border Background="{StaticResource PrimaryLightBrush}"
                BorderBrush="{StaticResource PrimaryTintBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,0,0,16"
                Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Message}" Foreground="{StaticResource PrimaryBrush}" FontWeight="Medium" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="✕" Command="{Binding ClearMessageCommand}" Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource TextMutedBrush}" Cursor="Hand" FontWeight="Bold" Padding="8,2"/>
            </Grid>
        </Border>

        <!-- Busy indicator -->
        <ProgressBar Style="{StaticResource ModernProgressBarStyle}"
                     IsIndeterminate="True"
                     Margin="0,0,0,16"
                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- Settlement action panel -->
        <Border Style="{StaticResource CardStyle}"
                Padding="20"
                Margin="0,0,0,18"
                Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Settlement actions" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding SelectionHeadline}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding SelectedPayment.RefundRequestDisplay}"
                                   FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,3,0,0"
                                   Visibility="{Binding SelectedPayment.RefundRequestDisplay, Converter={StaticResource StringToVisibilityConverter}}"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Close"
                            Command="{Binding ClearSelectionCommand}"
                            Style="{StaticResource GhostButtonStyle}"
                            Padding="12,5" FontSize="12" VerticalAlignment="Top"/>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.6*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Provider reference" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding ProviderReference, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}" Height="38"
                                 ToolTip="Bank transfer reference or cash receipt number"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Note" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding ActionNote, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}" Height="38"
                                 ToolTip="Stored on the payment record for auditing"/>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Confirm settlement"
                            Command="{Binding ConfirmPaymentCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="38" Padding="18,0" Margin="0,0,8,0"/>
                    <Button Content="Approve refund"
                            Command="{Binding ApproveRefundCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            Height="38" Padding="16,0" Margin="0,0,8,0"/>
                    <Button Content="Check in for boarding"
                            Command="{Binding CheckInTicketCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="38" Padding="16,0" Margin="0,0,8,0"/>
                    <Button Content="Reject payment"
                            Command="{Binding RequestRejectCommand}"
                            Style="{StaticResource DangerOutlineButtonStyle}"
                            Height="38" Padding="16,0"/>
                </StackPanel>

                <!-- Two-stage rejection confirmation -->
                <Border Background="{StaticResource DangerLightBrush}"
                        BorderBrush="{StaticResource DangerBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,12"
                        Margin="0,14,0,0"
                        Visibility="{Binding IsConfirmingReject, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Rejecting cancels the ticket and releases the seat. This cannot be undone."
                                   Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                        <TextBlock Text="Reason" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,4"/>
                        <TextBox Text="{Binding RejectReason, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}" Height="38"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Confirm rejection"
                                    Command="{Binding RejectPaymentCommand}"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Height="36" Padding="16,0" Margin="0,0,8,0"/>
                            <Button Content="Keep payment"
                                    Command="{Binding CancelRejectCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Height="36" Padding="14,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Ledger table -->
        <Border Style="{StaticResource CardStyle}" Padding="0">
            <StackPanel>
                <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="PAYMENT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="1" Text="PASSENGER" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="2" Text="TRIP" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="3" Text="CHANNEL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="4" Text="AMOUNT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="5" Text="STATE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="6" Text="ACTION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                    </Grid>
                </Border>
                <ItemsControl ItemsSource="{Binding Payments}"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.6*"/>
                                        <ColumnDefinition Width="1.6*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1.3*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1.3*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TicketCode}" FontFamily="Consolas, Segoe UI" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding CreatedAtDisplay}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding ReferenceDisplay}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PassengerName}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ConfirmedByDisplay, StringFormat='Confirmed by {0}'}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RouteSummary}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding DepartureDisplay, StringFormat='Departs {0}'}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ChannelDisplay}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding PaidAtDisplay, StringFormat='Paid {0}'}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="4" Text="{Binding AmountDisplay}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="5" VerticalAlignment="Center">
                                        <Border Style="{StaticResource LedgerBadgeStyle}">
                                            <TextBlock Text="{Binding Status, Converter={StaticResource PaymentStatusToDisplay}}" Style="{StaticResource LedgerBadgeTextStyle}"/>
                                        </Border>
                                        <TextBlock Text="{Binding TicketStatus, Converter={StaticResource TicketStatusToDisplay}, StringFormat='Ticket: {0}'}"
                                                   FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <Button Grid.Column="6"
                                            Content="Manage"
                                            Command="{Binding DataContext.SelectPaymentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="14,5" FontSize="12" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Empty state -->
                <StackPanel Visibility="{Binding HasNoPayments, Converter={StaticResource BooleanToVisibilityConverter}}"
                            HorizontalAlignment="Center" Margin="0,32,0,32">
                    <TextBlock Text="💳" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="No payments match the current filter" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Change the ledger status or clear the search box to see more records."
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

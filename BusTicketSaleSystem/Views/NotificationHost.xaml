<UserControl x:Class="BusTicketSaleSystem.Views.NotificationHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}"
             IsHitTestVisible="{Binding IsVisible}"
             HorizontalAlignment="Center"
             VerticalAlignment="Top"
             Margin="0,16,0,0">

    <!-- Transient toast. Owned by the shell so it outlives the ViewModel that raised it:
         a message about a completed booking must survive the navigation to My Tickets. -->
    <Border Background="{Binding Kind, Converter={StaticResource NotificationKindToBrush}, ConverterParameter=Surface}"
            BorderBrush="{Binding Kind, Converter={StaticResource NotificationKindToBrush}, ConverterParameter=Border}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="16,12"
            MinWidth="320"
            MaxWidth="620"
            Effect="{StaticResource ElevatedShadow}"
            Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Glyph carries the severity independently of colour, for colour-blind users. -->
            <Border Grid.Column="0"
                    Width="22" Height="22"
                    CornerRadius="11"
                    Background="{Binding Kind, Converter={StaticResource NotificationKindToBrush}, ConverterParameter=Accent}"
                    VerticalAlignment="Top"
                    Margin="0,1,12,0">
                <TextBlock Text="{Binding Kind, Converter={StaticResource NotificationKindToGlyph}}"
                           Foreground="White"
                           FontSize="12"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <TextBlock Grid.Column="1"
                       Text="{Binding Message}"
                       Foreground="{Binding Kind, Converter={StaticResource NotificationKindToBrush}, ConverterParameter=Accent}"
                       FontSize="13"
                       FontWeight="Medium"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="2"
                    Command="{Binding DismissCommand}"
                    Style="{StaticResource GhostButtonStyle}"
                    Content="✕"
                    FontSize="12"
                    Padding="8,2"
                    Margin="12,0,0,0"
                    ToolTip="{DynamicResource ToastDismiss}"
                    AutomationProperties.Name="{DynamicResource ToastDismiss}"/>
        </Grid>
    </Border>
</UserControl>

<Window x:Class="BusTicketSaleSystem.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BusTicketSaleSystem.ViewModels"
        xmlns:common="clr-namespace:BusTicketSaleSystem.Common"
        Title="OmniBus - Executive Administration Portal"
        Height="860" Width="1340"
        MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource AppFont}">

    <Window.Resources>
        <common:TabActiveBrushConverter x:Key="AdminNavBgConverter" ActiveBrush="{StaticResource PrimaryBrush}" InactiveBrush="Transparent"/>
        <common:TabActiveTextBrushConverter x:Key="AdminNavFgConverter" ActiveBrush="White" InactiveBrush="#94A3B8"/>
        <common:TabActiveBrushConverter x:Key="AdminNavIconConverter" ActiveBrush="#60A5FA" InactiveBrush="#64748B"/>
        <common:TabActiveBrushConverter x:Key="AdminNavIndicatorConverter" ActiveBrush="{StaticResource AccentBrush}" InactiveBrush="Transparent"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}">
            <Grid Margin="16,24,16,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Sidebar Brand Header -->
                <StackPanel Grid.Row="0" Margin="4,0,4,28">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42" CornerRadius="10" Background="#2563EB" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconBus}" Fill="White" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="OmniBus Admin" Foreground="White" FontSize="17" FontWeight="Bold"/>
                            <TextBlock Text="MANAGEMENT CONSOLE" Foreground="#38BDF8" FontSize="10" FontWeight="Bold" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Separator Background="#1E293B" Margin="0,20,0,12"/>
                    <TextBlock Text="OPERATIONAL MODULES" Foreground="#64748B" FontSize="10" FontWeight="Bold" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- Navigation Links -->
                <StackPanel Grid.Row="1">
                    <!-- Dashboard -->
                    <Button Command="{Binding DashboardCommand}"
                            Style="{StaticResource SidebarButtonStyle}"
                            Background="{Binding ActiveTab, Converter={StaticResource AdminNavBgConverter}, ConverterParameter=Dashboard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="3" Height="18" CornerRadius="1.5"
                                    Background="{Binding ActiveTab, Converter={StaticResource AdminNavIndicatorConverter}, ConverterParameter=Dashboard}"
                                    HorizontalAlignment="Left"/>
                            <Path Grid.Column="1" Data="{StaticResource IconDashboard}"
                                  Fill="{Binding ActiveTab, Converter={StaticResource AdminNavIconConverter}, ConverterParameter=Dashboard}"
                                  Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Column="2" Text="Dashboard" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{Binding ActiveTab, Converter={StaticResource AdminNavFgConverter}, ConverterParameter=Dashboard}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <!-- Routes -->
                    <Button Command="{Binding RoutesCommand}"
                            Style="{StaticResource SidebarButtonStyle}"
                            Background="{Binding ActiveTab, Converter={StaticResource AdminNavBgConverter}, ConverterParameter=Routes}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="3" Height="18" CornerRadius="1.5"
                                    Background="{Binding ActiveTab, Converter={StaticResource AdminNavIndicatorConverter}, ConverterParameter=Routes}"
                                    HorizontalAlignment="Left"/>
                            <Path Grid.Column="1" Data="{StaticResource IconRoute}"
                                  Fill="{Binding ActiveTab, Converter={StaticResource AdminNavIconConverter}, ConverterParameter=Routes}"
                                  Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Column="2" Text="Routes" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{Binding ActiveTab, Converter={StaticResource AdminNavFgConverter}, ConverterParameter=Routes}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <!-- Bus Fleet -->
                    <Button Command="{Binding BusesCommand}"
                            Style="{StaticResource SidebarButtonStyle}"
                            Background="{Binding ActiveTab, Converter={StaticResource AdminNavBgConverter}, ConverterParameter=Buses}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="3" Height="18" CornerRadius="1.5"
                                    Background="{Binding ActiveTab, Converter={StaticResource AdminNavIndicatorConverter}, ConverterParameter=Buses}"
                                    HorizontalAlignment="Left"/>
                            <Path Grid.Column="1" Data="{StaticResource IconBus}"
                                  Fill="{Binding ActiveTab, Converter={StaticResource AdminNavIconConverter}, ConverterParameter=Buses}"
                                  Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Column="2" Text="Bus Fleet" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{Binding ActiveTab, Converter={StaticResource AdminNavFgConverter}, ConverterParameter=Buses}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <!-- Trip Schedules -->
                    <Button Command="{Binding TripsCommand}"
                            Style="{StaticResource SidebarButtonStyle}"
                            Background="{Binding ActiveTab, Converter={StaticResource AdminNavBgConverter}, ConverterParameter=Trips}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="3" Height="18" CornerRadius="1.5"
                                    Background="{Binding ActiveTab, Converter={StaticResource AdminNavIndicatorConverter}, ConverterParameter=Trips}"
                                    HorizontalAlignment="Left"/>
                            <Path Grid.Column="1" Data="{StaticResource IconClock}"
                                  Fill="{Binding ActiveTab, Converter={StaticResource AdminNavIconConverter}, ConverterParameter=Trips}"
                                  Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Column="2" Text="Trip Schedules" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{Binding ActiveTab, Converter={StaticResource AdminNavFgConverter}, ConverterParameter=Trips}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <!-- Accounts -->
                    <Button Command="{Binding AccountsCommand}"
                            Style="{StaticResource SidebarButtonStyle}"
                            Background="{Binding ActiveTab, Converter={StaticResource AdminNavBgConverter}, ConverterParameter=Accounts}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="3" Height="18" CornerRadius="1.5"
                                    Background="{Binding ActiveTab, Converter={StaticResource AdminNavIndicatorConverter}, ConverterParameter=Accounts}"
                                    HorizontalAlignment="Left"/>
                            <Path Grid.Column="1" Data="{StaticResource IconUser}"
                                  Fill="{Binding ActiveTab, Converter={StaticResource AdminNavIconConverter}, ConverterParameter=Accounts}"
                                  Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Column="2" Text="User Accounts" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{Binding ActiveTab, Converter={StaticResource AdminNavFgConverter}, ConverterParameter=Accounts}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Bottom Logout / Session -->
                <Border Grid.Row="2" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                    <StackPanel>
                        <!-- Admin Profile Pill -->
                        <Border Background="#162345" CornerRadius="10" Padding="12,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#2563EB" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <Path Data="{StaticResource IconUser}" Fill="White" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AdminDisplayName}" FontWeight="Bold" FontSize="12" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding AdminRole, StringFormat='Role: {0}'}" FontSize="10" Foreground="#38BDF8"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Sign Out Button -->
                        <Button Command="{Binding LogoutCommand}" Style="{StaticResource SidebarButtonStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="{StaticResource IconLogout}" Fill="#EF4444" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="1" Text="Sign Out" FontSize="13" FontWeight="SemiBold" Foreground="#FCA5A5" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,0">
                <Grid Height="64">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Breadcrumbs -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Administration" Foreground="{StaticResource TextMutedBrush}" FontSize="13" FontWeight="Medium"/>
                        <TextBlock Text=" / " Foreground="{StaticResource TextMutedBrush}" FontSize="13" Margin="4,0"/>
                        <TextBlock Text="{Binding ActiveTab}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                    </StackPanel>

                    <!-- Right Status Indicator -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,14,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="●" Foreground="{StaticResource SuccessBrush}" FontSize="9" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Admin Mode" Foreground="#065F46" FontWeight="Bold" FontSize="11"/>
                            </StackPanel>
                        </Border>

                        <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource PrimaryLightBrush}" Margin="0,0,10,0">
                            <Path Data="{StaticResource IconShield}" Fill="{StaticResource PrimaryBrush}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding AdminDisplayName}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding AdminRole}" FontSize="11" Foreground="{StaticResource PrimaryBrush}" FontWeight="Medium"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- View Scroll Container -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ContentControl Content="{Binding CurrentViewModel}" Margin="28,24"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>

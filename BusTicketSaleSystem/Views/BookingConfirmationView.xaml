<UserControl x:Class="BusTicketSaleSystem.Views.BookingConfirmationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:BusTicketSaleSystem.Common"
             FontFamily="{StaticResource AppFont}">

    <UserControl.Resources>
        <common:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <StackPanel>
        <!-- Page Header -->
        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Xác nhận đặt vé &amp; Thanh toán" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Vui lòng kiểm tra lại thông tin chuyến đi và hành khách trước khi hệ thống tạo vé chính thức."
                           FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="← Quay lại chọn ghế"
                    Command="{Binding BackToSeatsCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    VerticalAlignment="Center"
                    Padding="16,8"/>
        </Grid>

        <!-- Status Message Banner -->
        <Border Background="{StaticResource PrimaryLightBrush}"
                BorderBrush="{StaticResource PrimaryTintBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,0,0,20"
                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="{StaticResource PrimaryBrush}" FontWeight="Medium"/>
        </Border>

        <!-- Main 2-Column Content -->
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Left: Journey Details & Passenger Info -->
                <ColumnDefinition Width="1.5*"/>
                <!-- Gap -->
                <ColumnDefinition Width="24"/>
                <!-- Right: Price Breakdown & Confirmation CTA -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ====================================================
                 LEFT COLUMN: JOURNEY & PASSENGER REVIEW
                 ==================================================== -->
            <StackPanel Grid.Column="0">
                <!-- Journey Review Card -->
                <Border Style="{StaticResource CardStyle}" Padding="26" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="Chi tiết chuyến đi" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,18"/>

                        <!-- Departure & Arrival Stations Timeline -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Departure Station -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ĐIỂM XUẤT PHÁT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding Trip.Origin}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,2"/>
                                <TextBlock Text="{Binding Trip.DepartureTime, StringFormat='{}{0:HH:mm - dd/MM/yyyy}'}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="Bến xe trung tâm" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Route Connector Arrow -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0" HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconArrowRight}" Fill="{StaticResource PrimaryBrush}" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center"/>
                                <TextBlock Text="Trực tiếp" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Arrival Station -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                <TextBlock Text="ĐIỂM ĐẾN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding Trip.Destination}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,2" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding Trip.ArrivalTime, StringFormat='{}{0:HH:mm - dd/MM/yyyy}'}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Right"/>
                                <TextBlock Text="Bến xe điểm đến" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                        <!-- Vehicle & Amenities Details -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Loại xe vận hành" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding Trip.BusType}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                <TextBlock Text="Điều hòa • WiFi • Nước uống miễn phí" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="Vị trí ghế đã chọn" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                <Border Background="{StaticResource PrimaryLightBrush}"
                                        CornerRadius="6"
                                        Padding="12,4"
                                        Margin="0,4,0,0"
                                        HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Seat.DisplayName}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Passenger Details Card -->
                <Border Style="{StaticResource CardStyle}" Padding="24">
                    <StackPanel>
                        <TextBlock Text="Thông tin người đi xe" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Họ tên hành khách:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding PassengerName}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Số điện thoại:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding PassengerPhone}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Hình thức nhận vé:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="Vé điện tử (E-Ticket) lưu trực tiếp trong tài khoản" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ====================================================
                 RIGHT COLUMN: BILLING & PAYMENT SUMMARY
                 ==================================================== -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="26" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Chi tiết thanh toán" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                    <!-- Price Row 1: Ticket Fare -->
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Tiền vé xe (1 hành khách)" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding PriceDisplay}" HorizontalAlignment="Right" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Grid>

                    <!-- Price Row 2: Service Fee -->
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Bảo hiểm hành khách" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="Miễn phí" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                    </Grid>

                    <!-- Price Row 3: Luggage -->
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="Hành lý kèm theo (20kg)" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="Miễn phí" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                    </Grid>

                    <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                    <!-- Total Amount -->
                    <Grid Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Tổng tiền thanh toán" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Đã bao gồm VAT &amp; bảo hiểm" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding PriceDisplay}" HorizontalAlignment="Right" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Security Notice -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconShield}" Fill="{StaticResource PrimaryBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Giao dịch bảo mật qua hệ thống OmniBus Express." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Phương thức thanh toán" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding PaymentMethods}"
                              SelectedItem="{Binding SelectedPaymentMethod}"
                              Height="36"
                              Margin="0,0,0,16"
                              Padding="8,4"/>

                    <!-- Primary Complete Booking Button -->
                    <Button Content="Xác nhận &amp; Đặt vé ngay"
                            Command="{Binding CompleteBookingCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            Height="46"
                            FontSize="15"
                            FontWeight="Bold"/>

                    <!-- Secondary Back Button -->
                    <Button Content="Quay lại chọn ghế khác"
                            Command="{Binding BackToSeatsCommand}"
                            Style="{StaticResource GhostButtonStyle}"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"/>

                    <!-- Progress Bar during booking -->
                    <ProgressBar Height="6"
                                 IsIndeterminate="True"
                                 Style="{StaticResource ModernProgressBarStyle}"
                                 Margin="0,14,0,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>

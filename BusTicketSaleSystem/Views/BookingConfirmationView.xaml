<UserControl x:Class="BusTicketSaleSystem.Views.BookingConfirmationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:BusTicketSaleSystem.Common"
             FontFamily="{StaticResource AppFont}">

    <StackPanel>
        <!-- Page Header -->
        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Confirm booking &amp; payment" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Review the trip and passenger details before the ticket is issued."
                           FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="← Back to seat selection"
                    Command="{Binding BackToSeatsCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    VerticalAlignment="Center"
                    Padding="16,8"/>
        </Grid>

        <!-- Status Message Banner -->
        <Border Background="{StaticResource PrimaryLightBrush}"
                BorderBrush="{StaticResource PrimaryTintBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,0,0,20"
                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="{StaticResource PrimaryBrush}" FontWeight="Medium"/>
        </Border>

        <!-- Main 2-Column Content -->
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Left: Journey Details & Passenger Info -->
                <ColumnDefinition Width="1.5*"/>
                <!-- Gap -->
                <ColumnDefinition Width="24"/>
                <!-- Right: Price Breakdown & Confirmation CTA -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ====================================================
                 LEFT COLUMN: JOURNEY & PASSENGER REVIEW
                 ==================================================== -->
            <StackPanel Grid.Column="0">
                <!-- Journey Review Card -->
                <Border Style="{StaticResource CardStyle}" Padding="26" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="Trip details" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,18"/>

                        <!-- Departure & Arrival Stations Timeline -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Departure Station -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="DEPARTURE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding Trip.Origin}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,2"/>
                                <TextBlock Text="{Binding Trip.DepartureTime, StringFormat='{}{0:HH:mm - dd/MM/yyyy}'}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="Central bus station" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Route Connector Arrow -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0" HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconArrowRight}" Fill="{StaticResource PrimaryBrush}" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center"/>
                                <TextBlock Text="Direct" FontSize="11" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Arrival Station -->
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                <TextBlock Text="DESTINATION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding Trip.Destination}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,2" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding Trip.ArrivalTime, StringFormat='{}{0:HH:mm - dd/MM/yyyy}'}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Right"/>
                                <TextBlock Text="Arrival station" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>

                        <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                        <!-- Vehicle & Amenities Details -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Coach type" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding Trip.BusType}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0"/>
                                <TextBlock Text="Air conditioning • WiFi • Free water" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="Selected seats" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                <Border Background="{StaticResource PrimaryLightBrush}"
                                        CornerRadius="6"
                                        Padding="12,4"
                                        Margin="0,4,0,0"
                                        HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding SelectedSeatNumbers}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap" TextAlignment="Right"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Passenger Details Card -->
                <Border Style="{StaticResource CardStyle}" Padding="24">
                    <StackPanel>
                        <TextBlock Text="Passenger details" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Passenger name:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding PassengerName}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Phone number:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding PassengerPhone}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Ticket delivery:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="E-ticket stored in your account" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ====================================================
                 RIGHT COLUMN: BILLING & PAYMENT SUMMARY
                 ==================================================== -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="26" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Payment summary" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                    <!-- Price Row 1: Ticket Fare -->
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="{Binding SeatCount, StringFormat='Ticket fare ({0} seats)'}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding PriceDisplay}" HorizontalAlignment="Right" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Grid>

                    <!-- Price Row 2: Service Fee -->
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Passenger insurance" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="Included" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                    </Grid>

                    <!-- Price Row 3: Luggage -->
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="Checked luggage (20kg)" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="Included" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                    </Grid>

                    <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,16"/>

                    <!-- Total Amount -->
                    <Grid Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Total to pay" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="VAT and insurance included" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding PriceDisplay}" HorizontalAlignment="Right" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Security Notice -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconShield}" Fill="{StaticResource PrimaryBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Secured by the OmniBus Express platform." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Payment method" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding PaymentMethods}"
                              SelectedItem="{Binding SelectedPaymentMethod, Mode=TwoWay}"
                              DisplayMemberPath="Display"
                              Height="36"
                              Margin="0,0,0,8"
                              Padding="8,4">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="IsEnabled" Value="{Binding IsEnabled}"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>

                    <TextBlock Text="{Binding SelectedMethodWarning}"
                               FontSize="12"
                               Foreground="{StaticResource AccentBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"
                               Visibility="{Binding SelectedMethodWarning, Converter={StaticResource StringToVisibilityConverter}}"/>

                    <!-- Primary Complete Booking Button -->
                    <Button Content="Confirm &amp; book now"
                            Command="{Binding CompleteBookingCommand}"
                            Style="{StaticResource AccentButtonStyle}"
                            Height="46"
                            FontSize="15"
                            FontWeight="Bold"/>

                    <!-- Secondary Back Button -->
                    <Button Content="Choose a different seat"
                            Command="{Binding BackToSeatsCommand}"
                            Style="{StaticResource GhostButtonStyle}"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"/>

                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"
                               Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                    <!-- Progress Bar during booking -->
                    <ProgressBar Height="6"
                                 IsIndeterminate="True"
                                 Style="{StaticResource ModernProgressBarStyle}"
                                 Margin="0,14,0,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>

<UserControl x:Class="BusTicketSaleSystem.Views.BusCompanyDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BusTicketSaleSystem.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:BusCompanyDetailViewModel}"
             FontFamily="{StaticResource AppFont}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,40">
            <!-- Top Navigation / Back Button -->
            <Button Command="{Binding BackCommand}"
                    Style="{StaticResource GhostButtonStyle}"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource IconArrowLeft}" Fill="{StaticResource PrimaryBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="← Quay lại danh sách nhà xe" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource PrimaryBrush}"/>
                </StackPanel>
            </Button>

            <!-- ====================================================
                 1. COMPANY HEADER & INTRO & RATING CARD
                 ==================================================== -->
            <Border Style="{StaticResource CardStyle}" Padding="26" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 1.1 HÌNH ẢNH NHÀ XE -->
                    <Border Grid.Column="0" Height="180" CornerRadius="14" Background="#0F4C81" ClipToBounds="True" Margin="0,0,24,0">
                        <Grid>
                            <Border Opacity="0.92">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#0F4C81" Offset="0.0"/>
                                        <GradientStop Color="#1E3A8A" Offset="0.5"/>
                                        <GradientStop Color="#2563EB" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border Width="56" Height="56" CornerRadius="28" Background="White" HorizontalAlignment="Center" Margin="0,0,0,8">
                                    <Path Data="{StaticResource IconBus}" Fill="{StaticResource PrimaryBrush}" Width="28" Height="28" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding Company.CompanyName}" FontSize="15" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                <TextBlock Text="ĐỘI XE CHẤT LƯỢNG CAO" FontSize="9.5" FontWeight="SemiBold" Foreground="#BAE6FD" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Border VerticalAlignment="Bottom" Background="#0F172A" Opacity="0.75" Padding="8,4">
                                <TextBlock Text="Hình ảnh phương tiện nhà xe" FontSize="10" Foreground="White" HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 1.2 THÔNG TIN NHÀ XE + GIỚI THIỆU + ĐÁNH GIÁ (NGẮN GỌN) -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{Binding Company.CompanyName}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="10,3" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Đối tác chính thức bến xe" FontSize="11" FontWeight="Bold" Foreground="#065F46"/>
                            </Border>
                        </StackPanel>

                        <!-- Đánh giá về nhà xe (ngắn gọn) -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                            <Border Background="{StaticResource WarningLightBrush}" CornerRadius="6" Padding="8,3" Margin="0,0,10,0">
                                <TextBlock Text="{Binding Company.RatingDisplay}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                            </Border>
                            <TextBlock Text="{Binding Company.ReviewCountDisplay}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>

                            <!-- Highlight tags ngắn gọn -->
                            <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                <TextBlock Text="✓ Đúng giờ 4.9★" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Border>
                            <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                <TextBlock Text="✓ Xe sạch sẽ 4.8★" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Border>
                            <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="✓ An toàn 4.9★" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Border>
                        </StackPanel>

                        <!-- Thông tin hotline & khu vực hoạt động -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                            <TextBlock Text="Hotline: " FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding Company.Hotline}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,16,0"/>
                            <TextBlock Text="•" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,16,0"/>
                            <Path Data="{StaticResource IconPin}" Fill="{StaticResource TextMutedBrush}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Khu vực: " FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding Company.OperatingArea}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <!-- Giới thiệu sơ qua về nhà xe -->
                        <TextBlock Text="{Binding Company.Description}"
                                   FontSize="12.5"
                                   LineHeight="19"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>

                        <!-- Tiện ích dịch vụ -->
                        <ItemsControl ItemsSource="{Binding Company.AmenityList}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,0,6,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="✓ " Foreground="{StaticResource SuccessBrush}" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="{Binding}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ====================================================
                 2. CHỖ ĐỂ HIỆN NHỮNG CHUYẾN XE CÒN CHẠY TÍNH TỪ THỜI ĐIỂM ĐẶT VÉ
                 ==================================================== -->
            <Border Style="{StaticResource CardStyle}" Padding="26">
                <StackPanel>
                    <!-- Section Title & Date Picker Filter -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Các Chuyến Xe Đang Chạy Khả Dụng" FontSize="19" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Hiển thị các chuyến xe còn hoạt động. Chuyến còn chỗ hiển thị sáng để đặt vé; chuyến hết chỗ hoặc đã xuất bến được làm mờ."
                                       FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Date Filter -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Ngày khởi hành:" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                                        Height="38"
                                        Width="160"/>
                        </StackPanel>
                    </Grid>

                    <!-- Busy Indicator -->
                    <ProgressBar Style="{StaticResource ModernProgressBarStyle}"
                                 IsIndeterminate="True"
                                 Margin="0,0,0,14"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <!-- The ViewModel already set StatusMessage for load failures and for a
                         sold-out trip, but nothing rendered it, so both cases were silent. -->
                    <Border Background="{StaticResource WarningLightBrush}"
                            BorderBrush="{StaticResource WarningBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,10"
                            Margin="0,0,0,14"
                            Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}">
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="#92400E"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- Available Trips List -->
                    <ItemsControl ItemsSource="{Binding AvailableTrips}"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Card Opacity làm nhạt đi khi chuyến không còn chạy/hết chỗ, sáng khi còn chạy -->
                                <Border Style="{StaticResource CardStyle}"
                                        Padding="20,16"
                                        Margin="0,0,0,12"
                                        Background="White"
                                        BorderBrush="#E2E8F0"
                                        Opacity="{Binding CardOpacity}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <!-- Col 0: Giờ đi -> Giờ đến & Tuyến -->
                                            <ColumnDefinition Width="220"/>
                                            <!-- Col 1: Hạng xe & Thông tin xe -->
                                            <ColumnDefinition Width="*"/>
                                            <!-- Col 2: Giá vé cho từng hạng & Tình trạng ghế -->
                                            <ColumnDefinition Width="170"/>
                                            <!-- Col 3: Nút đặt vé -->
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Col 0: Giờ đi -> Giờ đến & Tuyến -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding DepartureTime, StringFormat={}{0:HH:mm}}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <Path Data="{StaticResource IconArrowRight}" Fill="{StaticResource TextMutedBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="10,0"/>
                                                <TextBlock Text="{Binding ArrivalTime, StringFormat={}{0:HH:mm}}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Route}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                            <TextBlock Text="{Binding DepartureTime, StringFormat='Ngày đi: {0:dd/MM/yyyy}'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Col 1: Hạng xe & Thông tin xe -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0">
                                            <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" Margin="0,0,0,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconBus}" Fill="{StaticResource PrimaryBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Hạng xe: " FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding BusType}" FontSize="12.5" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="{Binding IntermediateStops, StringFormat='Điểm dừng: {0}'}"
                                                       FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding LicensePlate, StringFormat='Biển số: {0}'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Col 2: Giá vé cho từng hạng & Tình trạng ghế -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0">
                                            <TextBlock Text="Giá vé theo hạng:" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding PriceDisplay}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,2,0,4"/>

                                            <!-- Badge tình trạng chỗ -->
                                            <Border Background="{StaticResource SurfaceMutedBrush}" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding StatusBadgeText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Col 3: Nút đặt vé chuyển thẳng đến chọn ghế -->
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                            <!-- ToolTip states WHY the button is dead; the row is
                                                 only dimmed otherwise. Theme.xaml sets
                                                 ToolTipService.ShowOnDisabled so it still shows. -->
                                            <Button Content="Chọn ghế &amp; Đặt vé"
                                                    Command="{Binding DataContext.BookTripCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding IsAvailable}"
                                                    ToolTip="{Binding StatusBadgeText}"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    Padding="18,10"
                                                    FontSize="13"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty State Khi Không Còn Chuyến Nào Khả Dụng -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="28"
                            Opacity="0.65"
                            Visibility="{Binding HasNoTrips, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="50" Height="50" CornerRadius="25" Background="{StaticResource SurfaceMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,12">
                                <Path Data="{StaticResource IconBus}" Fill="{StaticResource TextMutedBrush}" Width="24" Height="24" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Hiện không có chuyến xe nào còn chạy tính từ thời điểm này" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Các chuyến xe trong ngày đã xuất bến hoặc chưa được xếp lịch. Vui lòng chọn ngày khởi hành khác hoặc quay lại chọn nhà xe khác."
                                       FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,16"/>
                            <Button Content="← Quay lại danh sách nhà xe"
                                    Command="{Binding BackCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Center"
                                    Padding="18,8"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="BusTicketSaleSystem.Views.BookingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BusTicketSaleSystem.ViewModels"
             xmlns:common="clr-namespace:BusTicketSaleSystem.Common"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:BookingViewModel}"
             FontFamily="{StaticResource AppFont}">


    <StackPanel>
        <!-- Header & Back navigation -->
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Đặt vé xe khách trực tuyến"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Tìm kiếm lịch trình xuất bến và chọn nhà xe ưng ý cho chuyến đi của bạn."
                           FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="← Về trang chủ"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding BackToHomeCommand}"
                    VerticalAlignment="Center"
                    Padding="14,8"/>
        </Grid>
        <!-- Status / Loading Bar -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#EFF6FF"
                        BorderBrush="#BFDBFE"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10,4"
                        Margin="0,0,10,0"
                        ToolTip="Vị trí xuất phát của bạn (có thể đổi tại thanh tiêu đề phía trên)">
                    <TextBlock Text="{Binding LocationBanner}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#1D4ED8"/>
                </Border>
                <Border Background="{StaticResource PrimaryLightBrush}"
                        BorderBrush="{StaticResource PrimaryTintBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10,4"
                        Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}">
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12"
                               FontWeight="Medium"
                               Foreground="{StaticResource PrimaryBrush}"/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ProgressBar Width="120"
                             IsIndeterminate="True"
                             Style="{StaticResource ModernProgressBarStyle}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Button Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        ToolTip="Làm mới danh sách"
                        AutomationProperties.Name="Làm mới danh sách nhà xe"
                        Width="36" Height="36"
                        Margin="8,0,0,0">
                    <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource PrimaryBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ====================================================
             BUS OPERATORS LIST (Gom theo nhà xe)
             ==================================================== -->
        <ItemsControl ItemsSource="{Binding Companies}"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="20,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- Col 0: Logo, Tên nhà xe, Tuyến hoạt động -->
                                <ColumnDefinition Width="3.2*"/>
                                <!-- Col 1: Đánh giá & Giới thiệu ngắn -->
                                <ColumnDefinition Width="2.8*"/>
                                <!-- Col 2: Giá thấp nhất ("Giá chỉ từ xxx VND") -->
                                <ColumnDefinition Width="2*"/>
                                <!-- Col 3: Nút chọn nhà xe -->
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Column 0: Logo nha xe - Ten nha xe - Khu vuc hoat dong -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <Button Command="{Binding DataContext.SelectCompanyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Padding="0"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,0,6"
                                        ToolTip="Nhấn để xem thông tin chi tiết nhà xe và lịch chạy">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource PrimaryLightBrush}" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding LogoText}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding CompanyName}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Chính hãng" FontSize="9.5" FontWeight="Bold" Foreground="#065F46"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Hotline, StringFormat='Hotline: {0}'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>

                                <!-- Khu vực hoạt động / Tuyến đường -->
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Path Data="{StaticResource IconPin}" Fill="{StaticResource PrimaryBrush}" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Khu vực: " FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding OperatingArea}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Column 1: Đánh giá về nhà xe & Thông tin ngắn -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Border Background="{StaticResource WarningLightBrush}" CornerRadius="6" Padding="7,3" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding RatingDisplay}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"/>
                                    </Border>
                                    <TextBlock Text="{Binding ReviewCountDisplay}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Description}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxHeight="36"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Column 2: Giá thấp nhất ("Giá chỉ từ xxx VND") & Tình trạng chuyến -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="14,0">
                                <TextBlock Text="Giá vé thấp nhất" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding MinPriceDisplay}"
                                           FontSize="16.5"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           Margin="0,2,0,4"/>

                                <Border Background="{StaticResource SurfaceMutedBrush}"
                                        CornerRadius="8"
                                        Padding="7,2"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding TripStatusDisplay}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                            </StackPanel>

                            <!-- Column 3: Nút bấm chọn nhà xe -->
                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                <Button Content="Chọn nhà xe →"
                                        Command="{Binding DataContext.SelectCompanyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Padding="18,10"
                                        FontSize="13"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Empty State When No Companies Found -->
        <Border Style="{StaticResource CardStyle}"
                Padding="36,32"
                Margin="0,0,0,20"
                HorizontalAlignment="Stretch"
                Visibility="{Binding HasNoCompanies, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center">
                <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource PrimaryLightBrush}" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Path Data="{StaticResource IconSearch}" Fill="{StaticResource PrimaryBrush}" Width="24" Height="24" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <TextBlock Text="Không tìm thấy nhà xe phù hợp"
                           FontSize="18"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Không có nhà xe nào hoạt động theo lộ trình hoặc ngày đã chọn. Thử xem tất cả các nhà xe đang hoạt động."
                           FontSize="13"
                           Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,6,0,18"/>
                <Button Content="Xem tất cả nhà xe"
                        Command="{Binding ShowAllTripsCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Center"
                        Padding="20,10"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

<UserControl x:Class="BusTicketSaleSystem.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BusTicketSaleSystem.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HistoryViewModel}"
             xmlns:common="clr-namespace:BusTicketSaleSystem.Common"
             FontFamily="{StaticResource AppFont}">


    <StackPanel>
        <!-- Page Header & Summary -->
        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Lịch sử chuyến đi"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Xem lại các chuyến đi trước đây và dễ dàng đặt lại các tuyến quen thuộc."
                           FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Stat pill -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource PrimaryLightBrush}"
                        CornerRadius="8"
                        Padding="14,8"
                        Margin="0,0,10,0">
                    <TextBlock Text="{Binding TotalCompletedTripsText}"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="{StaticResource PrimaryBrush}"/>
                </Border>
                <Border Background="#ECFDF5"
                        CornerRadius="8"
                        Padding="14,8">
                    <TextBlock Text="{Binding TotalDistanceTraveledText}"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="{StaticResource SuccessBrush}"/>
                </Border>
                <Button Content="Làm mới"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="14,8"
                        Margin="10,0,0,0"/>
            </StackPanel>
        </Grid>

        <ProgressBar Height="4"
                     Margin="0,0,0,12"
                     IsIndeterminate="True"
                     Style="{StaticResource ModernProgressBarStyle}"
                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <Border Background="{StaticResource DangerLightBrush}"
                BorderBrush="{StaticResource DangerBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,0,0,16"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" FontSize="13" Foreground="{StaticResource DangerBrush}" FontWeight="Medium" TextWrapping="Wrap"/>
        </Border>

        <!-- Past Trips Table / Card -->
        <Border Style="{StaticResource CardStyle}" Padding="0">
            <StackPanel>
                <!-- Table Header Row -->
                <Grid Background="#F1F5F9" Height="44">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="DATE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                    <TextBlock Grid.Column="1" Text="ROUTE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBlock Grid.Column="2" Text="COACH" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBlock Grid.Column="3" Text="SEAT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBlock Grid.Column="4" Text="FARE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBlock Grid.Column="5" Text="STATUS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBlock Grid.Column="6" Text="ACTION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="10,0,20,0" HorizontalAlignment="Right"/>
                </Grid>

                <!-- Table Rows -->
                <ItemsControl ItemsSource="{Binding HistoryTrips}"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Date -->
                                    <StackPanel Grid.Column="0" Margin="20,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Date}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Time}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>

                                    <!-- Route -->
                                    <TextBlock Grid.Column="1" Text="{Binding Route}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>

                                    <!-- Coach -->
                                    <TextBlock Grid.Column="2" Text="{Binding BusType}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>

                                    <!-- Seats -->
                                    <TextBlock Grid.Column="3" Text="{Binding Seats}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>

                                    <!-- Fare -->
                                    <TextBlock Grid.Column="4" Text="{Binding Fare}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>

                                    <!-- Ticket status (DB literal rendered in English) -->
                                    <TextBlock Grid.Column="5" Text="{Binding Status, Converter={StaticResource TicketStatusToDisplay}}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>

                                    <!-- Action: Book Again -->
                                    <Button Grid.Column="6"
                                            Content="Book Again"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding DataContext.BookAgainCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right"
                                            Margin="0,0,20,0"
                                            Padding="10,4"
                                            FontSize="12"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Empty State When No History -->
                <Border Padding="40,32"
                        Visibility="{Binding HasNoHistory, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource PrimaryLightBrush}" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <Path Data="{StaticResource IconClock}" Fill="{StaticResource PrimaryBrush}" Width="24" Height="24" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Chưa có lịch sử chuyến đi"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Các chuyến đi đã hoàn thành hoặc đã hủy sẽ được ghi nhận tại đây."
                                   FontSize="13"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,16"/>
                        <Button Content="Tìm chuyến xe mới"
                                Command="{Binding BookAgainCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Center"
                                Padding="20,8"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

<UserControl x:Class="BusTicketSaleSystem.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BusTicketSaleSystem.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HomeViewModel}"
             FontFamily="{StaticResource AppFont}">

    <StackPanel>
        <!-- Greeting Header -->
        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Welcome back, " FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding UserName}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="!" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
                <TextBlock Text="Search scheduled routes, choose your preferred seat, and view your bookings."
                           FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="View My Tickets"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding ViewTicketCommand}"
                    VerticalAlignment="Center"
                    Padding="16,9"/>
        </Grid>

        <!-- ====================================================
             1. PROMINENT TRIP SEARCH BOX (HERO WIDGET)
             ==================================================== -->
        <Border Style="{StaticResource ElevatedCardStyle}" Margin="0,0,0,28" Padding="28,24">
            <StackPanel>
                <!-- Search Box Title -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource PrimaryLightBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconSearch}" Fill="{StaticResource PrimaryBrush}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Find &amp; Book Your Bus Trip" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Compare express routes across northern and central intercity lines" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- Input Controls Grid -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Origin -->
                        <ColumnDefinition Width="2.2*"/>
                        <!-- Swap Button -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Destination -->
                        <ColumnDefinition Width="2.2*"/>
                        <!-- Departure Date -->
                        <ColumnDefinition Width="1.8*"/>
                        <!-- Passengers -->
                        <ColumnDefinition Width="1.5*"/>
                        <!-- Search Button -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Origin -->
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Path Data="{StaticResource IconPin}" Fill="{StaticResource PrimaryBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Origin (From)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding ProvinceList}"
                                  SelectedItem="{Binding Origin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Text="{Binding Origin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  Height="42"
                                  VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Swap Button -->
                    <Button Grid.Column="1"
                            Command="{Binding SwapLocationsCommand}"
                            ToolTip="Swap locations"
                            Width="38" Height="38"
                            VerticalAlignment="Bottom"
                            Margin="0,0,8,2"
                            Background="{StaticResource SurfaceMutedBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="19">
                                    <Path Data="{StaticResource IconSwap}" Fill="{StaticResource PrimaryBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Destination -->
                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Path Data="{StaticResource IconPin}" Fill="{StaticResource AccentBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Destination (To)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding ProvinceList}"
                                  SelectedItem="{Binding Destination, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Text="{Binding Destination, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  Height="42"
                                  VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Departure Date -->
                    <StackPanel Grid.Column="3" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Path Data="{StaticResource IconCalendar}" Fill="{StaticResource TextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Departure Date" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <DatePicker SelectedDate="{Binding DepartureDate}"
                                    Height="42"
                                    VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Passengers -->
                    <StackPanel Grid.Column="4" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Path Data="{StaticResource IconUser}" Fill="{StaticResource TextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Passengers" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding PassengerOptions}"
                                  SelectedItem="{Binding SelectedPassengers}"
                                  Height="42"
                                  VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Search Action Button -->
                    <StackPanel Grid.Column="5" VerticalAlignment="Bottom">
                        <Button Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding SearchCommand}"
                                Height="42"
                                Padding="20,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconSearch}" Fill="White" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Search Trips" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ====================================================
             2. PERSONAL STAT CARDS
             ==================================================== -->
        <Grid Margin="0,0,0,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Tickets -->
            <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Total Booked" FontSize="13" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalTickets}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,2"/>
                        <TextBlock Text="Tickets in system" FontSize="12" Foreground="{StaticResource PrimaryBrush}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="44" Height="44" CornerRadius="12" Background="{StaticResource PrimaryLightBrush}" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconTicket}" Fill="{StaticResource PrimaryBrush}" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 2: Upcoming Trips -->
            <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Upcoming Journeys" FontSize="13" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding UpcomingTripsCount}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,6,0,2"/>
                        <TextBlock Text="Ready for departure" FontSize="12" Foreground="{StaticResource SuccessBrush}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="44" Height="44" CornerRadius="12" Background="#EFF6FF" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconBus}" Fill="{StaticResource PrimaryBrush}" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 3: Total Spent -->
            <Border Grid.Column="4" Style="{StaticResource StatCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Total Spent" FontSize="13" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalSpent}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,2"/>
                        <TextBlock Text="Verified payments" FontSize="12" Foreground="{StaticResource SuccessBrush}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="44" Height="44" CornerRadius="12" Background="{StaticResource SuccessLightBrush}" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconCheck}" Fill="{StaticResource SuccessBrush}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 4: Loyalty Points / Rewards -->
            <Border Grid.Column="6" Style="{StaticResource StatCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Reward Tier" FontSize="13" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding RewardTier}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" Margin="0,6,0,2"/>
                        <TextBlock Text="{Binding RewardTierSubtext}" FontSize="12" Foreground="{StaticResource WarningBrush}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="44" Height="44" CornerRadius="12" Background="{StaticResource WarningLightBrush}" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconStar}" Fill="{StaticResource WarningBrush}" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ====================================================
             3. POPULAR ROUTES & DESTINATIONS
             ==================================================== -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Popular Express Routes"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Fastest direct journeys between major transit hubs"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,2,0,0"/>
            </StackPanel>
            <Button Grid.Column="1"
                    Content="Explore All Schedules"
                    Style="{StaticResource GhostButtonStyle}"
                    Command="{Binding SearchCommand}"
                    VerticalAlignment="Center"/>
        </Grid>

        <ItemsControl ItemsSource="{Binding PopularRoutes}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}" Margin="4,0,4,8" Padding="18">
                        <StackPanel>
                            <!-- Route Tag -->
                            <Border Background="{StaticResource PrimaryLightBrush}"
                                    CornerRadius="6"
                                    Padding="8,3"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,10">
                                <TextBlock Text="{Binding Tag}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                            </Border>

                            <!-- Route Names -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="{Binding From}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <Path Data="{StaticResource IconArrowRight}" Fill="{StaticResource PrimaryBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="6,0"/>
                                <TextBlock Text="{Binding To}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <TextBlock Text="{Binding Duration}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12"/>

                            <!-- Price and Book CTA -->
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="From" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding Price}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                </StackPanel>
                                <Button Content="Book"
                                        Style="{StaticResource AccentButtonStyle}"
                                        HorizontalAlignment="Right"
                                        Padding="14,6"
                                        FontSize="12"
                                        Command="{Binding DataContext.QuickBookCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>

<UserControl x:Class="BusTicketSaleSystem.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BusTicketSaleSystem.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HomeViewModel}"
             FontFamily="{StaticResource AppFont}">

    <StackPanel>
        <!-- Greeting Header -->
        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Chào mừng trở lại, " FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding UserName}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="!" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
                <TextBlock Text="Tìm kiếm chuyến xe, chọn ghế ngồi ưng ý và quản lý vé đã đặt dễ dàng."
                           FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Xem vé của tôi"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding ViewTicketCommand}"
                    VerticalAlignment="Center"
                    Padding="16,9"/>
        </Grid>

        <!-- Data load feedback -->
        <ProgressBar Height="4"
                     Margin="0,0,0,12"
                     IsIndeterminate="True"
                     Style="{StaticResource ModernProgressBarStyle}"
                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        <Border Background="{StaticResource DangerLightBrush}"
                BorderBrush="{StaticResource DangerBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10"
                Margin="0,0,0,16"
                Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <TextBlock Text="{Binding StatusMessage}" FontSize="13" Foreground="{StaticResource DangerBrush}" FontWeight="Medium" TextWrapping="Wrap"/>
        </Border>

        <!-- ====================================================
             1. PROMINENT TRIP SEARCH BOX (HERO WIDGET)
             ==================================================== -->
        <Border Style="{StaticResource ElevatedCardStyle}" Margin="0,0,0,28" Padding="28,24">
            <StackPanel>
                <!-- Search Box Title -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource PrimaryLightBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconSearch}" Fill="{StaticResource PrimaryBrush}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Tìm kiếm &amp; Đặt vé xe khách" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Tra cứu lịch trình và giá vé của các nhà xe liên tỉnh uy tín" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- Input Controls Grid -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Origin -->
                        <ColumnDefinition Width="2.2*"/>
                        <!-- Swap Button -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Destination -->
                        <ColumnDefinition Width="2.2*"/>
                        <!-- Departure Date -->
                        <ColumnDefinition Width="1.8*"/>
                        <!-- Passengers -->
                        <ColumnDefinition Width="1.5*"/>
                        <!-- Search Button -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Origin -->
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Path Data="{StaticResource IconPin}" Fill="{StaticResource PrimaryBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Điểm đi (Xuất phát)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding Origins}"
                                  SelectedItem="{Binding Origin, Mode=TwoWay}"
                                  IsEditable="False"
                                  IsTextSearchEnabled="True"
                                  Height="42"
                                  VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Swap Button -->
                    <Button Grid.Column="1"
                            Command="{Binding SwapLocationsCommand}"
                            ToolTip="Đảo chiều điểm đi / điểm đến"
                            AutomationProperties.Name="Đảo chiều điểm đi và điểm đến"
                            VerticalAlignment="Bottom"
                            Margin="0,0,8,2"
                            Background="{StaticResource SurfaceMutedBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="19">
                                    <Path Data="{StaticResource IconSwap}" Fill="{StaticResource PrimaryBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Destination -->
                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Path Data="{StaticResource IconPin}" Fill="{StaticResource AccentBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Điểm đến (Nơi đến)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding Destinations}"
                                  SelectedItem="{Binding Destination, Mode=TwoWay}"
                                  IsEditable="False"
                                  IsTextSearchEnabled="True"
                                  Height="42"
                                  VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Departure Date -->
                    <StackPanel Grid.Column="3" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Path Data="{StaticResource IconCalendar}" Fill="{StaticResource TextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Ngày khởi hành" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <!-- DisplayDateStart stops a past departure being picked at all, instead
                             of accepting it and failing on submit. -->
                        <DatePicker SelectedDate="{Binding DepartureDate}"
                                    DisplayDateStart="{Binding MinDepartureDate, Mode=OneTime}"
                                    Height="42"
                                    VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Passengers -->
                    <StackPanel Grid.Column="4" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Path Data="{StaticResource IconUser}" Fill="{StaticResource TextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Số hành khách" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding PassengerOptions}"
                                  SelectedItem="{Binding SelectedPassengers}"
                                  Height="42"
                                  VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- Search Action Button -->
                    <StackPanel Grid.Column="5" VerticalAlignment="Bottom">
                        <Button Style="{StaticResource AccentButtonStyle}"
                                Command="{Binding SearchCommand}"
                                Height="42"
                                IsDefault="True"
                                Padding="20,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconSearch}" Fill="White" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Tìm chuyến" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ====================================================
             2. PERSONAL STAT CARDS
             ==================================================== -->
        <Grid Margin="0,0,0,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Tickets -->
            <Border Grid.Column="0" Style="{StaticResource StatCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Total Booked" FontSize="13" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalTickets}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6,0,2"/>
                        <TextBlock Text="Tickets on your account" FontSize="12" Foreground="{StaticResource PrimaryBrush}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="44" Height="44" CornerRadius="12" Background="{StaticResource PrimaryLightBrush}" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconTicket}" Fill="{StaticResource PrimaryBrush}" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 2: Upcoming Trips -->
            <Border Grid.Column="2" Style="{StaticResource StatCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Upcoming Journeys" FontSize="13" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding UpcomingTripsCount}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,6,0,2"/>
                        <TextBlock Text="Active tickets ahead" FontSize="12" Foreground="{StaticResource SuccessBrush}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="44" Height="44" CornerRadius="12" Background="#EFF6FF" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconBus}" Fill="{StaticResource PrimaryBrush}" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 3: Total Spent -->
            <Border Grid.Column="4" Style="{StaticResource StatCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Total Paid" FontSize="13" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalSpent}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,2"/>
                        <TextBlock Text="Settled payments only" FontSize="12" Foreground="{StaticResource SuccessBrush}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="44" Height="44" CornerRadius="12" Background="{StaticResource SuccessLightBrush}" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconCheck}" Fill="{StaticResource SuccessBrush}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 4: Loyalty Points / Rewards -->
            <Border Grid.Column="6" Style="{StaticResource StatCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Reward Tier" FontSize="13" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding RewardTier}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" Margin="0,6,0,2"/>
                        <TextBlock Text="{Binding RewardTierSubtext}" FontSize="12" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="44" Height="44" CornerRadius="12" Background="{StaticResource WarningLightBrush}" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconStar}" Fill="{StaticResource WarningBrush}" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ====================================================
             3. POPULAR ROUTES & DESTINATIONS
             ==================================================== -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Các tuyến xe khách phổ biến"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Hành trình thuận tiện kết nối các tỉnh thành trọng điểm"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Xem tất cả lịch trình"
                        Style="{StaticResource GhostButtonStyle}"
                        Command="{Binding SearchCommand}"/>
                <Button Content="Làm mới"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding RefreshCommand}"
                        Margin="10,0,0,0"/>
            </StackPanel>
        </Grid>

        <ItemsControl ItemsSource="{Binding PopularRoutes}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}" Margin="4,0,4,12" Padding="16">
                        <StackPanel>
                            <!-- 1. Logo nha xe - Ten nha xe -->
                            <Button Command="{Binding DataContext.ViewCompanyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Padding="0"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,10"
                                    ToolTip="Nhấn để xem thông tin chi tiết nhà xe">
                                <StackPanel Orientation="Horizontal">
                                    <!-- Logo nhà xe -->
                                    <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource PrimaryLightBrush}" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding LogoText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <!-- Tên nhà xe -->
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CompanyName}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Xem chi tiết nhà xe →" FontSize="10" Foreground="{StaticResource PrimaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <!-- 2. Tuyến đường -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{Binding From}" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <Path Data="{StaticResource IconArrowRight}" Fill="{StaticResource PrimaryBrush}" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="6,0"/>
                                <TextBlock Text="{Binding To}" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <!-- 3. Điểm dừng trên đường -->
                            <TextBlock Text="{Binding StopsSummary}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,0,0,8"
                                       ToolTip="{Binding StopsSummary}"/>

                            <!-- Price and Book CTA -->
                            <Grid Margin="0,4,0,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Giá chỉ từ" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding Price}" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                </StackPanel>
                                <Button Content="Đặt vé"
                                        Style="{StaticResource AccentButtonStyle}"
                                        HorizontalAlignment="Right"
                                        Padding="14,6"
                                        FontSize="12"
                                        Command="{Binding DataContext.QuickBookCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Empty state when no route has any scheduled departure yet -->
        <Border Style="{StaticResource CardStyle}"
                Padding="32,28"
                Visibility="{Binding HasNoPopularRoutes, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="Chưa có chuyến xe nào"
                           FontSize="16"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Lịch trình chuyến xe sẽ hiển thị tại đây ngay khi các nhà xe công bố giờ xuất bến."
                           FontSize="13"
                           Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

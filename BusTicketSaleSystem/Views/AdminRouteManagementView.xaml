<UserControl x:Class="BusTicketSaleSystem.Views.AdminRouteManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:BusTicketSaleSystem.Common"
             FontFamily="{StaticResource AppFont}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <common:BooleanToVisibilityInvertedConverter x:Key="BooleanToVisibilityInvertedConverter"/>
        <common:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </UserControl.Resources>

    <StackPanel Margin="0,0,0,30">
        <TextBlock Text="Route Management" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
        <TextBlock Text="Quản lý các tuyến xe liên tỉnh và khoảng cách vận hành" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,16"/>

        <!-- Form Card -->
        <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Thêm tuyến đường mới" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}"
                           Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityInvertedConverter}}"/>
                <TextBlock Text="Cập nhật khoảng cách tuyến đường" FontWeight="Bold" FontSize="16" Foreground="{StaticResource PrimaryBrush}"
                           Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Điểm đi (Origin)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Origin, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Height="38"
                                 IsEnabled="{Binding IsEditing, Converter={StaticResource InverseBooleanConverter}}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="8,0,8,0">
                        <TextBlock Text="Điểm đến (Destination)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Height="38"
                                 IsEnabled="{Binding IsEditing, Converter={StaticResource InverseBooleanConverter}}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="8,0,8,0">
                        <TextBlock Text="Khoảng cách (km)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Distance, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Height="38"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Content="Thêm tuyến"
                                Command="{Binding AddCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="38"
                                Padding="16,0"
                                Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityInvertedConverter}}"/>

                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button Content="Lưu cập nhật"
                                    Command="{Binding UpdateCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Height="38"
                                    Padding="14,0"
                                    Margin="0,0,8,0"/>
                            <Button Content="Hủy"
                                    Command="{Binding CancelEditCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Height="38"
                                    Padding="12,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding Message}" Foreground="{StaticResource DangerBrush}" Margin="0,8,0,0" FontWeight="Medium"
                           Visibility="{Binding Message, Converter={StaticResource StringToVisibilityConverter}}"/>
            </StackPanel>
        </Border>

        <!-- Routes List Table -->
        <TextBlock Text="Danh sách tuyến xe đang khai thác" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
        <ItemsControl ItemsSource="{Binding Routes}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding RouteId, StringFormat='Mã tuyến: #{0}'}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DistanceKm, StringFormat={}{0:N1} km, TargetNullValue='Chưa xác định'}"
                                           FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="Cự ly di chuyển" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Sửa cự ly"
                                        Command="{Binding DataContext.SelectForEditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="12,5"
                                        FontSize="12"
                                        Margin="0,0,8,0"/>
                                <Button Content="Xóa"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Padding="12,5"
                                        FontSize="12"
                                        Foreground="{StaticResource DangerBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>

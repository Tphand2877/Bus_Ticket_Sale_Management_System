<Window x:Class="BusTicketSaleSystem.Views.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thanh toán vé xe"
        Height="720"
        Width="470"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Closed="PaymentWindow_Closed"
        Background="#F8FAFC">
    <Grid Margin="24">
        <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="{Binding TitleText}"
                       FontSize="17"
                       FontWeight="Bold"
                       Foreground="#166534"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding DescriptionText}"
                       FontSize="12"
                       Foreground="#64748B"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,4,0,12"/>

            <Image Source="{Binding BankQrImage}"
                   Width="240"
                   Height="240"
                   Stretch="Uniform"
                   Visibility="{Binding IsBankTransfer, Converter={StaticResource BooleanToVisibilityConverter}}"
                   Margin="0,0,0,8"/>
            <TextBlock Text="Quét mã QR bằng ứng dụng ngân hàng của bạn"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#166534"
                       HorizontalAlignment="Center"
                       Visibility="{Binding IsBankTransfer, Converter={StaticResource BooleanToVisibilityConverter}}"
                       Margin="0,0,0,10"/>

            <TextBlock Text="{Binding AmountText}"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#B91C1C"
                       HorizontalAlignment="Center"/>

            <Border Background="#FFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,10"
                    Width="330"
                    Margin="0,10,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding ReferenceCaption}"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#64748B"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ReferenceText}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#0F172A"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding CountdownText}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#B45309"
                       HorizontalAlignment="Center"
                       Visibility="{Binding IsBankTransfer, Converter={StaticResource BooleanToVisibilityConverter}}"
                       Margin="0,0,0,6"/>

            <TextBlock Text="{Binding StatusText}"
                       FontSize="12"
                       Foreground="#475569"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Width="340"
                       Margin="0,4,0,18"/>

            <!-- Themed styles so this dialog matches the rest of the app and inherits the
                 disabled/hover/focus states. ToolTip explains the disabled case. -->
            <Button Content="Tôi đã chuyển khoản — Gửi để nhân viên xác nhận"
                    Command="{Binding SubmitTransferCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Height="44"
                    Width="330"
                    IsDefault="True"
                    Margin="0,0,0,10"
                    ToolTip="Chỉ khả dụng khi chỗ vẫn đang được giữ."
                    Visibility="{Binding IsBankTransfer, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <Button Content="Mở lại trang thanh toán VNPay"
                    Command="{Binding OpenGatewayCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Height="44"
                    Width="330"
                    Margin="0,0,0,10"
                    Visibility="{Binding IsVnPay, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <Button Content="{Binding CloseButtonText}"
                    Command="{Binding CloseCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Height="38"
                    Width="330"
                    IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>

<UserControl
    x:Class="BusTicketSaleSystem.Views.ProfileView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="{StaticResource AppFont}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,24">

            <TextBlock
                Text="Profile &amp; Security"
                FontSize="26"
                FontWeight="Bold"
                Foreground="{StaticResource TextPrimaryBrush}" />

            <TextBlock
                Text="Manage your password, security settings, and personal information."
                Margin="0,4,0,20"
                Foreground="{StaticResource TextSecondaryBrush}"
                TextWrapping="Wrap" />

            <!-- Password and Security -->
            <Border
                Style="{StaticResource CardStyle}"
                Padding="24"
                Margin="0,0,0,16">

                <StackPanel>
                    <TextBlock
                        Text="Password &amp; Security"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextPrimaryBrush}" />

                    <TextBlock
                        Text="Change your password regularly to keep your account secure."
                        FontSize="12"
                        Foreground="{StaticResource TextMutedBrush}"
                        Margin="0,4,0,20"
                        TextWrapping="Wrap" />

                    <TextBlock Text="Current password" />

                    <PasswordBox
                        x:Name="CurrentPasswordBox"
                        Tag="CurrentPassword"
                        PasswordChanged="PasswordBox_OnPasswordChanged"
                        Style="{StaticResource ModernPasswordBoxStyle}"
                        Margin="0,4,0,12" />

                    <TextBlock Text="New password" />

                    <PasswordBox
                        x:Name="NewPasswordBox"
                        Tag="NewPassword"
                        PasswordChanged="PasswordBox_OnPasswordChanged"
                        Style="{StaticResource ModernPasswordBoxStyle}"
                        Margin="0,4,0,12" />

                    <TextBlock Text="Confirm new password" />

                    <PasswordBox
                        x:Name="ConfirmPasswordBox"
                        Tag="ConfirmPassword"
                        PasswordChanged="PasswordBox_OnPasswordChanged"
                        Style="{StaticResource ModernPasswordBoxStyle}"
                        Margin="0,4,0,16" />

                    <TextBlock
                        Text="{Binding PasswordStatusMessage}"
                        Foreground="{StaticResource DangerBrush}"
                        TextWrapping="Wrap"
                        Margin="0,0,0,12" />

                    <Button
                        Content="Change Password"
                        Command="{Binding ChangePasswordCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Left"
                        MinWidth="150" />
                </StackPanel>
            </Border>

            <!-- Personal Information -->
            <Border
                Style="{StaticResource CardStyle}"
                Padding="24">

                <StackPanel>
                    <TextBlock
                        Text="Personal Information"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextPrimaryBrush}" />

                    <TextBlock
                        Text="Update the personal information associated with your account."
                        FontSize="12"
                        Foreground="{StaticResource TextMutedBrush}"
                        Margin="0,4,0,20"
                        TextWrapping="Wrap" />

                    <TextBlock Text="Full name" />

                    <TextBox
                        Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource ModernTextBoxStyle}"
                        Margin="0,4,0,12" />

                    <TextBlock Text="Email" />

                    <TextBox
                        Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource ModernTextBoxStyle}"
                        Margin="0,4,0,12" />

                    <TextBlock Text="Phone" />

                    <TextBox
                        Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource ModernTextBoxStyle}"
                        Margin="0,4,0,16" />

                    <TextBlock
                        Text="{Binding ProfileStatusMessage}"
                        Foreground="{StaticResource SuccessBrush}"
                        TextWrapping="Wrap"
                        Margin="0,0,0,12" />

                    <Button
                        Content="Save Profile Changes"
                        Command="{Binding SaveProfileCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Left"
                        MinWidth="160" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
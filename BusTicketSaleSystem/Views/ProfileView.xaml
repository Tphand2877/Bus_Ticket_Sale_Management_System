<UserControl
    x:Class="BusTicketSaleSystem.Views.ProfileView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="clr-namespace:BusTicketSaleSystem.Common"
    FontFamily="{StaticResource AppFont}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,24">

            <TextBlock
                Text="{DynamicResource ProfileTitle}"
                FontSize="26"
                FontWeight="Bold"
                Foreground="{StaticResource TextPrimaryBrush}" />

            <TextBlock
                Text="{DynamicResource ProfileSubtitle}"
                Margin="0,4,0,20"
                Foreground="{StaticResource TextSecondaryBrush}"
                TextWrapping="Wrap" />

            <!-- Signed-in account identity -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                    <TextBlock Text="{Binding Username, StringFormat=Signed in as {0}}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryBrush}" />
                </Border>
                <Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="6" Padding="10,4">
                    <TextBlock Text="{Binding AccountRole}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </Border>
            </StackPanel>

            <!-- Language Settings Card -->
            <Border Style="{StaticResource CardStyle}" Padding="24" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource LanguageSettingsTitle}"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{DynamicResource LanguageSettingsDesc}"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,4,0,16" TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal">
                        <!-- Tiếng Việt Option -->
                        <Button Command="{Binding SelectVietnameseCommand}"
                                Style="{StaticResource GhostButtonStyle}"
                                ToolTip="Chuyển sang Tiếng Việt"
                                Margin="0,0,12,0" Padding="0">
                            <Border Background="{StaticResource SurfaceMutedBrush}"
                                    BorderBrush="{StaticResource PrimaryBrush}"
                                    BorderThickness="1.5"
                                    CornerRadius="10"
                                    Padding="16,12"
                                    MinWidth="160">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🇻🇳" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Tiếng Việt" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Vietnamese" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Button>

                        <!-- English Option -->
                        <Button Command="{Binding SelectEnglishCommand}"
                                Style="{StaticResource GhostButtonStyle}"
                                ToolTip="Switch to English"
                                Padding="0">
                            <Border Background="{StaticResource SurfaceMutedBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1.5"
                                    CornerRadius="10"
                                    Padding="16,12"
                                    MinWidth="160">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🇬🇧" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="English" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Tiếng Anh" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Password and Security -->
            <Border
                Style="{StaticResource CardStyle}"
                Padding="24"
                Margin="0,0,0,16">

                <StackPanel>
                    <TextBlock
                        Text="{DynamicResource ProfilePasswordTitle}"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextPrimaryBrush}" />

                    <TextBlock
                        Text="{DynamicResource ProfilePasswordSubtitle}"
                        FontSize="12"
                        Foreground="{StaticResource TextMutedBrush}"
                        Margin="0,4,0,20"
                        TextWrapping="Wrap" />

                    <TextBlock Text="{DynamicResource ProfileCurrentPassword}" />

                    <PasswordBox
                        x:Name="CurrentPasswordBox"
                        Tag="CurrentPassword"
                        PasswordChanged="PasswordBox_OnPasswordChanged"
                        Style="{StaticResource ModernPasswordBoxStyle}"
                        Margin="0,4,0,12" />

                    <TextBlock Text="{DynamicResource ProfileNewPassword}" />

                    <PasswordBox
                        x:Name="NewPasswordBox"
                        Tag="NewPassword"
                        PasswordChanged="PasswordBox_OnPasswordChanged"
                        Style="{StaticResource ModernPasswordBoxStyle}"
                        Margin="0,4,0,12" />

                    <TextBlock Text="{DynamicResource ProfileConfirmPassword}" />

                    <PasswordBox
                        x:Name="ConfirmPasswordBox"
                        Tag="ConfirmPassword"
                        PasswordChanged="PasswordBox_OnPasswordChanged"
                        Style="{StaticResource ModernPasswordBoxStyle}"
                        Margin="0,4,0,16" />

                    <!-- Failure-only banner: successes are toasted, so danger-red is always right. -->
                    <TextBlock
                        Text="{Binding PasswordStatusMessage}"
                        Foreground="{StaticResource DangerBrush}"
                        TextWrapping="Wrap"
                        Margin="0,0,0,12"
                        Visibility="{Binding PasswordStatusMessage, Converter={StaticResource StringToVisibilityConverter}}" />

                    <Button
                        Content="{DynamicResource ProfileChangePasswordButton}"
                        Command="{Binding ChangePasswordCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Left"
                        MinWidth="150" />
                </StackPanel>
            </Border>

            <!-- Personal Information -->
            <Border
                Style="{StaticResource CardStyle}"
                Padding="24">

                <StackPanel>
                    <TextBlock
                        Text="{DynamicResource ProfilePersonalInfoTitle}"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextPrimaryBrush}" />

                    <TextBlock
                        Text="{DynamicResource ProfilePersonalInfoSubtitle}"
                        FontSize="12"
                        Foreground="{StaticResource TextMutedBrush}"
                        Margin="0,4,0,20"
                        TextWrapping="Wrap" />

                    <TextBlock Text="{DynamicResource ProfileFullName}" />

                    <TextBox
                        Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource ModernTextBoxStyle}"
                        Margin="0,4,0,12" />

                    <TextBlock Text="{DynamicResource ProfileEmail}" />

                    <TextBox
                        Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource ModernTextBoxStyle}"
                        Margin="0,4,0,12" />

                    <TextBlock Text="{DynamicResource ProfilePhoneNumber}" />

                    <TextBox
                        Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource ModernTextBoxStyle}"
                        MaxLength="15"
                        common:TextInputRestrictions.PhoneNumber="True"
                        Margin="0,4,0,16" />

                    <!-- Failure-only banner; it used to render errors in success-green. -->
                    <TextBlock
                        Text="{Binding ProfileStatusMessage}"
                        Foreground="{StaticResource DangerBrush}"
                        TextWrapping="Wrap"
                        Margin="0,0,0,12"
                        Visibility="{Binding ProfileStatusMessage, Converter={StaticResource StringToVisibilityConverter}}" />

                    <Button
                        Content="{DynamicResource ProfileSavePersonalButton}"
                        Command="{Binding SaveProfileCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Left"
                        MinWidth="160" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
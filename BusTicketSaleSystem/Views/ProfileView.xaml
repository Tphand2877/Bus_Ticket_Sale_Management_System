<UserControl x:Class="BusTicketSaleSystem.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BusTicketSaleSystem.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ProfileViewModel}"
             FontFamily="{StaticResource AppFont}">

    <StackPanel>
        <!-- Page Header -->
        <StackPanel Margin="0,0,0,24">
            <TextBlock Text="Account &amp; Profile 👤"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="Manage your personal information, loyalty tier, and security settings."
                       FontSize="14"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Two Column Layout: Profile Info (Left) & Password Change (Right) -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- ====================================================
                 LEFT CARD: PERSONAL INFORMATION
                 ==================================================== -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,16,0" Padding="24">
                <StackPanel>
                    <!-- Header with Avatar -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="64" Height="64" CornerRadius="32" Background="{StaticResource PrimaryBrush}" VerticalAlignment="Center">
                            <TextBlock Text="AM" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FullName}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding Email}" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,4"/>
                            <Border Background="#FEF3C7" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding MembershipTier}" FontSize="11" FontWeight="SemiBold" Foreground="#92400E"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,18"/>

                    <!-- Form Fields -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Full Name" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Email Address" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Phone Number" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="National ID / Passport" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding NationalId, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Residential Address" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Emergency Contact" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding EmergencyContact, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <!-- Save Profile Status Message -->
                    <TextBlock Text="{Binding ProfileStatusMessage}"
                               Foreground="{StaticResource SuccessBrush}"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Margin="0,0,0,12"/>

                    <!-- Action Button -->
                    <Button Content="Save Profile Changes"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding SaveProfileCommand}"
                            HorizontalAlignment="Left"
                            Padding="20,10"/>
                </StackPanel>
            </Border>

            <!-- ====================================================
                 RIGHT CARD: CHANGE PASSWORD (PROTOTYPE)
                 ==================================================== -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="24">
                <StackPanel>
                    <TextBlock Text="Security &amp; Password 🔒"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Update your account credentials. (Phase 1 prototype placeholder)"
                               FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,4,0,18"/>

                    <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,18"/>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Current Password" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <PasswordBox Style="{StaticResource ModernPasswordBoxStyle}" Password="password123"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="New Password" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <PasswordBox Style="{StaticResource ModernPasswordBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Confirm New Password" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <PasswordBox Style="{StaticResource ModernPasswordBoxStyle}"/>
                    </StackPanel>

                    <!-- Feedback message -->
                    <TextBlock Text="{Binding PasswordStatusMessage}"
                               Foreground="{StaticResource SuccessBrush}"
                               FontWeight="SemiBold"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,0,0,14"/>

                    <!-- Update Password Button -->
                    <Button Content="Update Password"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ChangePasswordCommand}"
                            HorizontalAlignment="Stretch"
                            Height="40"/>

                    <!-- Info Box -->
                    <Border Background="#F1F5F9"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,24,0,0">
                        <StackPanel>
                            <TextBlock Text="💡 Note on Phase 1 Prototype" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Authentication and credential storage will be wired to backend database in Phase 2."
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>

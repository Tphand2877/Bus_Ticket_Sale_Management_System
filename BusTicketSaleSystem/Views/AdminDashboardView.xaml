<UserControl x:Class="BusTicketSaleSystem.Views.AdminDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BusTicketSaleSystem.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AdminDashboardViewModel}"
             FontFamily="{StaticResource AppFont}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <StackPanel>
        <!-- ====================================================
             1. HEADER & ACTION CONTROLS
             ==================================================== -->
        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Title & Operational Status -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Operations Dashboard" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Monitor routes, bus fleet status, scheduled trip departures, and real-time revenue."
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Header Quick Action Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding LastRefreshed}"
                           FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,14,0"/>

                <Button Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        ToolTip="Refresh Dashboard Data"
                        Height="38"
                        Padding="14,0"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconRefresh}" Fill="{StaticResource PrimaryBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Refresh" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding NavigateTripsCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Height="38"
                        Padding="16,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPlus}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="New Trip" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ====================================================
             ERROR / NOTICE BANNER
             ==================================================== -->
        <Border Background="#FEF2F2"
                BorderBrush="#FCA5A5"
                BorderThickness="1"
                CornerRadius="10"
                Padding="16,12"
                Margin="0,0,0,20"
                Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Data="{StaticResource IconShield}" Fill="{StaticResource DangerBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="{StaticResource DangerBrush}" FontWeight="Medium" VerticalAlignment="Center" FontSize="13"/>
                <Button Grid.Column="2" Content="✕" Command="{Binding ClearMessageCommand}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMutedBrush}" Cursor="Hand" FontWeight="Bold" Padding="6,2"/>
            </Grid>
        </Border>

        <!-- Busy indicator -->
        <ProgressBar Style="{StaticResource ModernProgressBarStyle}"
                     IsIndeterminate="True"
                     Margin="0,0,0,18"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

        <!-- ====================================================
             2. KPI SUMMARY METRIC CARDS
             ==================================================== -->
        <UniformGrid Columns="4" Margin="0,0,-12,12">
            <!-- Card 1: Settled revenue -->
            <Border Style="{StaticResource StatCardStyle}" Margin="0,0,12,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Text="TOTAL REVENUE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <Border HorizontalAlignment="Right" Width="32" Height="32" CornerRadius="8" Background="#ECFDF5">
                            <Path Data="{StaticResource IconChart}" Fill="{StaticResource SuccessBrush}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding Stats.TotalRevenueDisplay}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,8,0,2" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Row="2" Text="Settled payments" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                </Grid>
            </Border>

            <!-- Card 2: Awaiting settlement -->
            <Border Style="{StaticResource StatCardStyle}" Margin="0,0,12,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Text="AWAITING SETTLEMENT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <Border HorizontalAlignment="Right" Width="32" Height="32" CornerRadius="8" Background="#FFFBEB">
                            <Path Data="{StaticResource IconClock}" Fill="{StaticResource WarningBrush}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding Stats.PendingSettlementAmountDisplay}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" Margin="0,8,0,2" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Row="2" Text="{Binding Stats.PendingSettlementCaption}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>

            <!-- Card 3: Refunded -->
            <Border Style="{StaticResource StatCardStyle}" Margin="0,0,12,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Text="REFUNDED" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <Border HorizontalAlignment="Right" Width="32" Height="32" CornerRadius="8" Background="#FEF2F2">
                            <Path Data="{StaticResource IconArrowLeft}" Fill="{StaticResource DangerBrush}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding Stats.RefundedAmountDisplay}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Margin="0,8,0,2" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Row="2" Text="Returned to customers" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                </Grid>
            </Border>

            <!-- Card 4: Tickets sold -->
            <Border Style="{StaticResource StatCardStyle}" Margin="0,0,12,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Text="TICKETS SOLD" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <Border HorizontalAlignment="Right" Width="32" Height="32" CornerRadius="8" Background="#EFF6FF">
                            <Path Data="{StaticResource IconTicket}" Fill="{StaticResource PrimaryBrush}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding Stats.TicketsSold}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,6,0,2"/>
                    <TextBlock Grid.Row="2" Text="Paid and used tickets" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                </Grid>
            </Border>

            <!-- Card 5: Upcoming Trips -->
            <Border Style="{StaticResource StatCardStyle}" Margin="0,0,12,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Text="SCHEDULES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <Border HorizontalAlignment="Right" Width="32" Height="32" CornerRadius="8" Background="#F5F3FF">
                            <Path Data="{StaticResource IconClock}" Fill="#7C3AED" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding Stats.TripCount}" FontSize="24" FontWeight="Bold" Foreground="#7C3AED" Margin="0,6,0,2"/>
                    <TextBlock Grid.Row="2" Text="Upcoming departures" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                </Grid>
            </Border>

            <!-- Card 6: Bus Fleet -->
            <Border Style="{StaticResource StatCardStyle}" Margin="0,0,12,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Text="BUS FLEET" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <Border HorizontalAlignment="Right" Width="32" Height="32" CornerRadius="8" Background="#F0FDFA">
                            <Path Data="{StaticResource IconBus}" Fill="{StaticResource AccentBrush}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding Stats.BusCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,2"/>
                    <TextBlock Grid.Row="2" Text="Vehicles in fleet" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                </Grid>
            </Border>

            <!-- Card 7: Routes -->
            <Border Style="{StaticResource StatCardStyle}" Margin="0,0,12,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Text="ACTIVE ROUTES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <Border HorizontalAlignment="Right" Width="32" Height="32" CornerRadius="8" Background="#FEF3C7">
                            <Path Data="{StaticResource IconRoute}" Fill="{StaticResource WarningBrush}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding Stats.RouteCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" Margin="0,6,0,2"/>
                    <TextBlock Grid.Row="2" Text="Connected routes" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                </Grid>
            </Border>

            <!-- Card 8: Customers -->
            <Border Style="{StaticResource StatCardStyle}" Margin="0,0,12,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Text="CUSTOMERS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <Border HorizontalAlignment="Right" Width="32" Height="32" CornerRadius="8" Background="#EFF6FF">
                            <Path Data="{StaticResource IconUser}" Fill="#2563EB" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding Stats.CustomerCount}" FontSize="24" FontWeight="Bold" Foreground="#2563EB" Margin="0,6,0,2"/>
                    <TextBlock Grid.Row="2" Text="Registered accounts" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- ====================================================
             3. MAIN DASHBOARD CONTENT (2 COLUMNS)
             ==================================================== -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6.4*"/>
                <ColumnDefinition Width="3.6*"/>
            </Grid.ColumnDefinitions>

            <!-- ================================================
                 LEFT COLUMN: SCHEDULED TRIPS & RECENT BOOKINGS
                 ================================================ -->
            <StackPanel Grid.Column="0" Margin="0,0,18,0">

                <!-- Upcoming Scheduled Trips -->
                <Border Style="{StaticResource CardStyle}" Padding="22" Margin="0,0,0,22">
                    <StackPanel>
                        <!-- Section Header -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🕒" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Upcoming Scheduled Trips" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Next departing buses with assigned routes and ticket prices" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="24,2,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Content="Manage Trips ➔"
                                    Command="{Binding NavigateTripsCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    FontSize="12"
                                    Padding="12,6"
                                    VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Table Header -->
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,9" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.2*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.3*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ROUTE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="1" Text="BUS VEHICLE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="2" Text="SCHEDULE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="3" Text="FARE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <!-- Trips List -->
                        <ItemsControl ItemsSource="{Binding UpcomingTrips}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.2*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1.3*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Route -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Route}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding DateDisplay}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Bus Plate -->
                                            <Border Grid.Column="1"
                                                    Background="#F1F5F9"
                                                    BorderBrush="#CBD5E1"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="8,3"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding LicensePlate}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </Border>

                                            <!-- Schedule -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TimeRangeDisplay}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding DepartureFormatted}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0"/>
                                            </StackPanel>

                                            <!-- Fare -->
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding PriceDisplay}"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryBrush}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty State If No Trips -->
                        <StackPanel Visibility="{Binding HasNoUpcomingTrips, Converter={StaticResource BoolToVis}}"
                                    HorizontalAlignment="Center"
                                    Margin="0,20,0,10">
                            <!-- Show when empty -->
                            <TextBlock Text="🚍" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="No scheduled trips available" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Click '+ New Trip' at the top to schedule departures." FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Recent Ticket Bookings -->
                <Border Style="{StaticResource CardStyle}" Padding="22">
                    <StackPanel>
                        <!-- Section Header -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎟️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Recent Ticket Bookings" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Latest customer purchases and reserved passenger seats" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="24,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Table Header -->
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,9" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.8*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="TICKET CODE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="1" Text="PASSENGER" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="2" Text="ROUTE" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="3" Text="SEAT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="4" Text="AMOUNT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="5" Text="STATUS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <!-- Bookings List -->
                        <ItemsControl ItemsSource="{Binding RecentBookings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.8*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1.4*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Ticket Code -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TicketCode}" FontFamily="Consolas, Segoe UI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding BookingTimeDisplay}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Passenger -->
                                            <TextBlock Grid.Column="1" Text="{Binding PassengerDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                            <!-- Route -->
                                            <TextBlock Grid.Column="2" Text="{Binding RouteName}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                            <!-- Seat -->
                                            <Border Grid.Column="3" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SeatDisplay}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                            </Border>

                                            <!-- Price -->
                                            <TextBlock Grid.Column="4" Text="{Binding PriceDisplay}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                                            <!-- Status Badge -->
                                            <Border Grid.Column="5"
                                                    Background="#ECFDF5"
                                                    BorderBrush="#A7F3D0"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="8,3"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Status, Converter={StaticResource TicketStatusToDisplay}}" FontSize="11" FontWeight="SemiBold" Foreground="#065F46"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty State If No Bookings -->
                        <StackPanel Visibility="{Binding HasNoRecentBookings, Converter={StaticResource BoolToVis}}"
                                    HorizontalAlignment="Center"
                                    Margin="0,20,0,10">
                            <TextBlock Text="🎫" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="No ticket bookings recorded yet" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Customer orders and seat reservations will appear here automatically." FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ================================================
                 RIGHT COLUMN: SHORTCUTS, FLEET & SYSTEM INFO
                 ================================================ -->
            <StackPanel Grid.Column="1">

                <!-- Quick Management Actions -->
                <Border Style="{StaticResource CardStyle}" Padding="22" Margin="0,0,0,22">
                    <StackPanel>
                        <TextBlock Text="Quick Actions" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Jump directly to system configuration" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16"/>

                        <!-- Action: Routes -->
                        <Button Command="{Binding NavigateRoutesCommand}" Style="{StaticResource QuickActionButtonStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#FEF3C7" Margin="0,0,12,0">
                                    <TextBlock Text="🛣️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Routes &amp; Stops" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Add origins, destinations &amp; distance" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="➔" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Action: Buses -->
                        <Button Command="{Binding NavigateBusesCommand}" Style="{StaticResource QuickActionButtonStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#F0FDFA" Margin="0,0,12,0">
                                    <TextBlock Text="🚍" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Fleet &amp; Capacity" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Register buses &amp; auto-generate seats" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="➔" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Action: Trips -->
                        <Button Command="{Binding NavigateTripsCommand}" Style="{StaticResource QuickActionButtonStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#F5F3FF" Margin="0,0,12,0">
                                    <TextBlock Text="🕒" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Trip Departures" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Assign buses, schedules &amp; pricing" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="➔" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Action: Payments -->
                        <Button Command="{Binding NavigatePaymentsCommand}" Style="{StaticResource QuickActionButtonStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#FFFBEB" Margin="0,0,12,0">
                                    <TextBlock Text="💳" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Payments &amp; Settlement" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Confirm transfers, refunds &amp; check-in" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="➔" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Action: Reports -->
                        <Button Command="{Binding NavigateReportsCommand}" Style="{StaticResource QuickActionButtonStyle}" Margin="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#ECFDF5" Margin="0,0,12,0">
                                    <TextBlock Text="📊" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Revenue Reports" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Per-route revenue for any date range" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="➔" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Fleet Occupancy Overview -->
                <Border Style="{StaticResource CardStyle}" Padding="22" Margin="0,0,0,22">
                    <StackPanel>
                        <!-- Header -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Fleet Occupancy" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Seat capacity &amp; utilization" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="All Buses ➔"
                                    Command="{Binding NavigateBusesCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    FontSize="11"
                                    Padding="10,4"
                                    VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Bus Items -->
                        <ItemsControl ItemsSource="{Binding BusFleet}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Plate -->
                                                <TextBlock Grid.Column="0" Text="{Binding LicensePlate}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <!-- Type -->
                                                <TextBlock Grid.Column="1" Text="{Binding BusType}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                <!-- Occupancy Text -->
                                                <TextBlock Grid.Column="2" Text="{Binding OccupancyText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                            </Grid>
                                            <!-- Progress Bar -->
                                            <ProgressBar Style="{StaticResource ModernProgressBarStyle}"
                                                         Value="{Binding OccupancyPercentage, Mode=OneWay}"
                                                         Maximum="100"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty State -->
                        <TextBlock Visibility="{Binding HasNoBuses, Converter={StaticResource BoolToVis}}"
                                   Text="No buses registered in system."
                                   FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,8"/>
                    </StackPanel>
                </Border>

                <!-- System Runtime Information -->
                <Border Style="{StaticResource CardStyle}" Padding="22">
                    <StackPanel>
                        <TextBlock Text="System Environment" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>

                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="SQL Server instance" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding DatabaseServer}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                </Grid>
                                <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,8"/>

                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Catalog" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding DatabaseCatalog}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                </Grid>
                                <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,8"/>

                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Dashboard data" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding LastRefreshed}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                                <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,8"/>

                                <Grid>
                                    <TextBlock Text="Signed in as" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding AdminName}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
